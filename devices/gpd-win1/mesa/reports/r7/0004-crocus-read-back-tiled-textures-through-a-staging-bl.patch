From 127de529222508a719324400daae91a59efdfc57 Mon Sep 17 00:00:00 2001
From: Robin Eidissen <robinei@gmail.com>
Date: Mon, 12 Oct 2026 02:43:57 +0200
Subject: [PATCH 2/3] crocus: read back tiled textures through a staging blit
 on non-LLC parts

A read-only map of a tiled texture (glReadPixels, glGetTexImage with a
matching format) detiles with the CPU from an uncached (WC) mapping on
parts without LLC, which is slower than a GPU blit to a linear staging
texture plus a cached CPU map (the path already taken when a format
conversion is needed). Measured on a GPD Win 1 (Cherry Trail),
glReadPixels GL_RGBA from an RGBA8 FBO, median: 1280x720 10.5 -> 4.8 ms,
853x480 6.4 -> 3.9 ms, 640x480 4.9 -> 2.7 ms, 320x240 1.9 -> 1.3 ms;
glGetTexImage GL_RGBA 853x480 4.7 -> 3.9 ms. Reads with a conversion
(GL_BGRA) are unchanged, as are reads below 64 KiB. The data read is
byte-identical to the CPU path.
---
 src/gallium/drivers/crocus/crocus_resource.c | 21 +++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/crocus/crocus_resource.c b/src/gallium/drivers/crocus/crocus_resource.c
index f30420c..f32117f 100644
--- a/src/gallium/drivers/crocus/crocus_resource.c
+++ b/src/gallium/drivers/crocus/crocus_resource.c
@@ -1620,8 +1620,24 @@ crocus_transfer_map(struct pipe_context *ctx,
     * temporary and map that, to avoid the resolve.  (It might be better to
     * a tiled temporary and use the tiled_memcpy paths...)
     */
+   /* On non-LLC parts a read-only map of a tiled texture (glReadPixels,
+    * glGetTexImage without a format conversion) is otherwise detiled by the
+    * CPU from an uncached mapping. A GPU blit into a linear staging texture
+    * and a cached CPU map of that is faster for anything but tiny reads: on
+    * Cherry Trail 1280x720 RGBA 10.5 -> 4.8 ms, 640x480 4.9 -> 2.7 ms,
+    * 320x240 1.9 -> 1.3 ms per glReadPixels.
+    */
+   bool read_blit = !screen->devinfo.has_llc &&
+      resource->target != PIPE_BUFFER &&
+      surf->tiling != ISL_TILING_LINEAR &&
+      (usage & PIPE_MAP_READ) && !(usage & PIPE_MAP_WRITE) &&
+      !(usage & (PIPE_MAP_PERSISTENT | PIPE_MAP_COHERENT | PIPE_MAP_DIRECTLY)) &&
+      (uint64_t)box->width * box->height * box->depth *
+         util_format_get_blocksize(res->base.b.format) >= 64 * 1024;
+
    if (!(usage & PIPE_MAP_DISCARD_RANGE) &&
-       !crocus_has_invalid_primary(res, level, 1, box->z, box->depth))
+       !crocus_has_invalid_primary(res, level, 1, box->z, box->depth) &&
+       !read_blit)
       no_gpu = true;
 
    const struct isl_format_layout *fmtl = isl_format_get_layout(surf->format);
@@ -1643,6 +1659,9 @@ crocus_transfer_map(struct pipe_context *ctx,
           util_format_get_blocksize(res->base.b.format) >= 256 * 1024)
       map_would_stall = true;
 
+   if (read_blit && !no_gpu)
+      map_would_stall = true;
+
    if (map_would_stall && !no_gpu) {
       /* If we need a synchronous mapping and the resource is busy, or needs
        * resolving, we copy to/from a linear temporary buffer using the GPU.
