From d9205ebd866274f5e4bc37e860fe769f25320c6d Mon Sep 17 00:00:00 2001
From: Robin Eidissen <robinei@gmail.com>
Date: Mon, 12 Oct 2026 02:43:57 +0200
Subject: [PATCH 1/3] crocus: raise the GPU-blit upload threshold to 256 KiB on
 non-LLC parts

Measured on a GPD Win 1 (Cherry Trail), glTexSubImage2D RGBA tiles into a
1280x720 RGBA8 texture, 16 tiles per frame, CPU time per frame:
64 KiB tiles 1.6 ms (CPU tiled copy) vs 2.7-3.0 ms (staging + blit);
144 KiB 2.2-2.6 vs 2.9-3.0; 256 KiB 3.3-3.5 vs 3.4-3.5 (frame 5.5 vs 6.8);
400 KiB 6.6 vs 3.8-4.0; 576 KiB 10.5 vs 4.1-4.5. The crossover is between
256 and 400 KiB.
---
 src/gallium/drivers/crocus/crocus_resource.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/crocus/crocus_resource.c b/src/gallium/drivers/crocus/crocus_resource.c
index 824274b..f30420c 100644
--- a/src/gallium/drivers/crocus/crocus_resource.c
+++ b/src/gallium/drivers/crocus/crocus_resource.c
@@ -1631,13 +1631,16 @@ crocus_transfer_map(struct pipe_context *ctx,
    /* On non-LLC parts the CPU writes a tiled texture through an uncached
     * mapping, with the tiling done by the CPU. For larger write-only uploads
     * a linear staging texture written once and a GPU blit is cheaper (on
-    * Cherry Trail, 853x480 BGRA: 0.9 ms instead of 2.0 ms per upload).
+    * Cherry Trail, 853x480 BGRA: 0.9 ms instead of 2.0 ms per upload), while
+    * for uploads up to about 256 KiB the CPU tiled copy is cheaper (16 x 64 KiB
+    * tiles: 1.6 ms vs 2.8 ms; 16 x 256 KiB: 5.5 vs 6.8 ms per frame;
+    * 16 x 400 KiB: 7.3-7.9 vs 9.0 ms).
     */
    if (!screen->devinfo.has_llc && resource->target != PIPE_BUFFER &&
        surf->tiling != ISL_TILING_LINEAR &&
        (usage & PIPE_MAP_WRITE) && !(usage & PIPE_MAP_READ) &&
        (uint64_t)box->width * box->height * box->depth *
-          util_format_get_blocksize(res->base.b.format) >= 64 * 1024)
+          util_format_get_blocksize(res->base.b.format) >= 256 * 1024)
       map_would_stall = true;
 
    if (map_would_stall && !no_gpu) {
