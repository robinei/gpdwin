# GPD Win 1 lib32-mesa: Arch's lib32-mesa PKGBUILD 1:26.2.4-1 (PKGBUILD.arch, maintainers there) reduced like
# ../PKGBUILD (crocus + softpipe, hasvk; no LLVM, SPIRV-Tools, lm_sensors, video, OpenCL at runtime), for Wine's
# 32-bit games. Same package names as the installed Arch ones. See ../README.md.

pkgbase=lib32-mesa
pkgname=(
  lib32-mesa-gpd
  lib32-vulkan-intel-gpd
  lib32-vulkan-mesa-implicit-layers-gpd
)
pkgver=26.2.4
_pkgver=${pkgver/[a-z]/-&}
pkgrel=1.11
epoch=1
pkgdesc="Open-source OpenGL drivers - 32-bit (GPD Win 1 build: crocus + hasvk only)"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(
  lib32-expat
  lib32-gcc-libs
  lib32-glibc
