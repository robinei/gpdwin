prepare() {
  cd mesa-$_pkgver

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  echo "$_pkgver-arch$epoch.$pkgrel" >VERSION
}

build() {
  # Stage 1: native build-time compilers (see ../PKGBUILD)
  meson setup build-clc mesa-$_pkgver --buildtype=plain --wrap-mode=nofallback \
    -D mesa-clc=enabled -D install-mesa-clc=true -D llvm=enabled -D gallium-drivers= -D vulkan-drivers= \
    -D vulkan-layers= -D platforms= -D egl=disabled -D gbm=disabled -D glx=disabled -D glvnd=disabled
  meson compile -C build-clc mesa_clc vtn_bindgen2
  export PATH="$srcdir/build-clc/src/compiler/clc:$srcdir/build-clc/src/compiler/spirv:$PATH"

  # Stage 2: the 32-bit drivers
  # shellcheck disable=SC2054
  local meson_options=(
    --cross-file lib32
    --optimization 2
    -D android-libbacktrace=disabled
    -D b_ndebug=true
    -D platforms=x11,wayland
    -D gallium-drivers=crocus,softpipe
    -D vulkan-drivers=intel_hasvk
    -D vulkan-layers=device-select,anti-lag
    -D gallium-extra-hud=false
    -D gallium-va=disabled
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl=false
    -D video-codecs=
    -D mesa-clc=system
    -D llvm=disabled
    -D spirv-tools=disabled
    -D lmsensors=disabled
    -D libunwind=disabled
    -D valgrind=disabled
    -D html-docs=disabled
    -D intel-rt=disabled
    -D microsoft-clc=disabled
    -D gles1=disabled
    -D vulkan-loader-rpath=
    -D vulkan-manifest-per-architecture=false
  )

  arch-meson mesa-$_pkgver build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_lib32-mesa-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of lib32-mesa do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  depends=(
    lib32-expat
    lib32-gcc-libs
    lib32-glibc
    lib32-libdrm
    lib32-libglvnd
    lib32-libx11
    lib32-libxcb
    lib32-libxext
    lib32-libxshmfence
    lib32-libxxf86vm
    lib32-wayland
    lib32-zlib
    lib32-zstd

    mesa
  )
  optdepends=("opengl-man-pages: for the OpenGL API man pages")
  provides=(
    "lib32-mesa=$epoch:$pkgver-$pkgrel"
    "lib32-mesa-libgl=$epoch:$pkgver-$pkgrel"
    lib32-opengl-driver
  )
  conflicts=(lib32-mesa 'lib32-mesa-libgl<17.0.1-2')
  replaces=('lib32-mesa-libgl<17.0.1-2')

  meson install -C build --destdir "$pkgdir" --no-rebuild

  (
    local libdir=usr/lib32

    cd "$pkgdir"

    _pick vkintel $libdir/libvulkan_intel_hasvk.so

    _pick vkdevice $libdir/libVkLayer_MESA_anti_lag.so
    _pick vkdevice $libdir/libVkLayer_MESA_device_select.so

    rm -rv etc usr/{bin,include,share} 2>/dev/null || true

    # indirect rendering
    ln -sr $libdir/libGLX_{mesa,indirect}.so.0
  )

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_lib32-vulkan-intel-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of lib32-vulkan-intel do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  pkgdesc="Open-source Vulkan driver for Intel GPUs - 32-bit (GPD Win 1 build: hasvk only)"
  depends=(
    lib32-expat
    lib32-gcc-libs
    lib32-glibc
    lib32-libdisplay-info
    lib32-libdrm
    lib32-libx11
    lib32-libxcb
    lib32-libxshmfence
    lib32-systemd
    lib32-vulkan-icd-loader
    lib32-vulkan-mesa-implicit-layers
    lib32-wayland
    lib32-xcb-util-keysyms
    lib32-zlib
    lib32-zstd

    vulkan-intel
  )
  provides=("lib32-vulkan-intel=$epoch:$pkgver-$pkgrel" lib32-vulkan-driver)
  conflicts=(lib32-vulkan-intel)

  mv vkintel/* "$pkgdir"

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_lib32-vulkan-mesa-implicit-layers-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of lib32-vulkan-mesa-implicit-layers do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  pkgdesc="Mesa's implicit Vulkan layers - 32-bit"
  depends=(
    lib32-gcc-libs
    lib32-glibc
    lib32-libdrm
    lib32-libxcb
    lib32-wayland

    vulkan-mesa-implicit-layers
  )
  provides=("lib32-vulkan-mesa-implicit-layers=$epoch:$pkgver-$pkgrel")
  conflicts=(lib32-vulkan-mesa-implicit-layers lib32-vulkan-mesa-device-select)
  replaces=(lib32-vulkan-mesa-device-select)

  mv vkdevice/* "$pkgdir"

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}
