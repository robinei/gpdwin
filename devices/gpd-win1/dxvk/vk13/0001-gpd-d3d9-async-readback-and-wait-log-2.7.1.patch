+#include <chrono>
+#include <mutex>
+#include <map>
+#include <string>
+
+// GPD instrumentation (2026-10-12, port of the 2.4.1 patch to 2.7.1): which D3D9 calls make the CPU wait for the
+// GPU, and how long.
+namespace dxvk {
+  static void GpdWaitStat(const char* label, double ms, uint32_t a, uint32_t b, uint32_t c, uint32_t d) {
+    static std::mutex lock;
+    static std::map<std::string, std::pair<uint64_t, double>> stats;
+    static auto last = std::chrono::steady_clock::now();
+    static int detailed = 0;
+    std::lock_guard<std::mutex> guard(lock);
+    auto& e = stats[label];
+    e.first += 1;
+    e.second += ms;
+    if (detailed < 40 && ms > 1.0) {
+      detailed++;
+      Logger::warn(str::format("GPD wait ", label, " ", ms, " ms (a=", a, " b=", b, " c=", c, " d=0x", std::hex, d, ")"));
+    }
+    auto now = std::chrono::steady_clock::now();
+    if (now - last > std::chrono::seconds(5)) {
+      for (auto& s : stats)
+        Logger::warn(str::format("GPD wait summary 5s: ", s.first, ": ", s.second.first, " waits, ", s.second.second, " ms"));
+      stats.clear();
+      last = now;
+    }
+  }
+}
