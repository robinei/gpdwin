#!/bin/sh
# Battery charge limit (devices/gpd-win1/docs/power.md, "Charge limit"): charge to 4.144 V (~80%) instead of 4.384 V,
# and let wheel change it without sudo (Utilities > Full Charge, pegasus/utils/tools/charge.sh).
# Run by 90-charge-limit.rules (driver (re)probe) and charge-limit.service (boot): at boot 2026-10-12
# udev never processed the charger's add event, so the rule alone left 4.384 V.
#   charge-limit [udev|boot]   (boot waits up to 60 s for the charger to appear)
f=/sys/class/power_supply/bq24190-charger/constant_charge_voltage
limit=4144000
if [ "$1" = boot ]; then
    i=0
    while [ ! -e $f ] && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
fi
[ -e $f ] || { echo "no charger ($f)"; exit 1; }
chgrp wheel $f && chmod g+w $f
echo $limit > $f
echo "${1:-manual}: $(cat $f) uV"
