--- a/src/themes/pegasus-theme-grid/theme.qml	2026-10-07 17:24:12.691573414 +0200
+++ b/src/themes/pegasus-theme-grid/theme.qml	2026-10-07 17:24:12.706800448 +0200
@@ -167,8 +167,48 @@
     }
 
     function launchGame() {
+        if (launchOverlay.visible)
+            return; // already starting one
         api.memory.set('collection', topbar.currentCollection.name);
         api.memory.set('game', gamegrid.currentGame.title);
-        gamegrid.currentGame.launch();
+        launchOverlay.title = gamegrid.currentGame.title;
+        launchOverlay.visible = true;
+        launchTimer.game = gamegrid.currentGame;
+        launchTimer.start();
+    }
+
+    // GPD: once the game process has started, Pegasus deletes its UI and waits for the game to
+    // exit, so its last frame stays on screen until the game's window appears (several seconds
+    // for Wine games on the Atom). Draw "Starting ..." first and launch a moment later, so that
+    // last frame says what is happening instead of looking frozen.
+    Rectangle {
+        id: launchOverlay
+        property string title: ""
+        anchors.fill: parent
+        z: 1000
+        visible: false
+        color: "#d8000000"
+
+        Text {
+            anchors.centerIn: parent
+            width: parent.width * 0.8
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.WordWrap
+            text: "Starting " + launchOverlay.title + "\u2026"
+            color: "#eeeeee"
+            font.pixelSize: vpx(36)
+        }
+    }
+    Timer {
+        id: launchTimer
+        property var game
+        interval: 100 // a few frames, so the overlay is on screen before the UI goes away
+        onTriggered: game.launch()
+    }
+    Connections {
+        target: api
+        // no teardown happens in these cases, so take the overlay away again
+        onEventLaunchError: launchOverlay.visible = false
+        onEventSelectGameFile: launchOverlay.visible = false
     }
 }
