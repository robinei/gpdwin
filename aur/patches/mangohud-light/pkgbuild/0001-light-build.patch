--- a/PKGBUILD
+++ b/PKGBUILD
@@ -3,45 +3,70 @@
 # Contributor: Ranieri Althoff <ranisalt+aur at gmail dot com>
 # Contributor: Mark Wagie <mark dot wagie at proton dot me>
 _pkgname=MangoHud
-pkgname=mangohud
+# GPD light build: the repo package's python/matplotlib/numpy (mangoplot) and glfw (mangoapp,
+# for gamescope) are left out; the overlay itself is unchanged. Also builds the 32-bit libraries
+# (as Arch's separate lib32-mangohud does) from the same source, so our source patches cover both.
+pkgbase=mangohud-light
+pkgname=(mangohud-light lib32-mangohud-light)
 pkgver=0.8.4
 pkgrel=1
 pkgdesc="A Vulkan overlay layer for monitoring FPS, temperatures, CPU/GPU load and more."
 arch=('x86_64')
 url="https://github.com/flightlessmango/MangoHud"
 license=('MIT')
-makedepends=('appstream' 'cmocka' 'git' 'glslang' 'libxnvctrl' 'libxrandr' 'meson' 'python-mako' 'vulkan-headers')
-depends=('dbus' 'fmt' 'glfw' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxkbcommon' 'python' 'python-matplotlib' 'python-numpy' 'vulkan-icd-loader' 'wayland')
-optdepends=('gamescope: Use MangoApp as an overlay within gamescope'
-            'libxnvctrl: NVIDIA GPU stats by XNVCtrl')
-replaces=("$pkgname-common" "$pkgname-common-wayland" "$pkgname-common-x11" "mangoapp" "$pkgname-x11" "$pkgname-wayland")
-conflicts=("$pkgname-common" "$pkgname-common-wayland" "$pkgname-common-x11" "mangoapp" "$pkgname-x11" "$pkgname-wayland")
-source=("$pkgname-$pkgver.tar.xz::https://github.com/flightlessmango/MangoHud/releases/download/v$pkgver/$_pkgname-v$pkgver-Source.tar.xz")
+makedepends=('glslang' 'libxrandr' 'meson' 'python-mako' 'vulkan-headers'
+             'dbus' 'fmt' 'libglvnd' 'libx11' 'libxkbcommon' 'vulkan-icd-loader' 'wayland'
+             'lib32-dbus' 'lib32-libglvnd' 'lib32-libx11' 'lib32-libxkbcommon' 'lib32-libxrandr'
+             'lib32-vulkan-icd-loader' 'lib32-wayland')
+source=("$pkgbase-$pkgver.tar.xz::https://github.com/flightlessmango/MangoHud/releases/download/v$pkgver/$_pkgname-v$pkgver-Source.tar.xz")
 b2sums=('06bdfcd26e14ff544e4dea4e39b8f7da6119d87fc7e14f381cf8c47bba69508a4768b8584600424adb8ca2a2f6f4c2d84d63683addeb83bd0dd9a1e055febdb8')
 
 prepare() {
     cd "$_pkgname-v$pkgver"
 
-    # Use system cmocka instead of subproject
+    # Use system cmocka (only for the tests, which this build disables) instead of subproject
     sed --in-place "s/  cmocka = subproject('cmocka')//g" meson.build
     sed --in-place "s/cmocka_dep = cmocka.get_variable('cmocka_dep')/cmocka_dep = dependency('cmocka')/g" meson.build
 }
 
-build() {
-    arch-meson "$_pkgname-v$pkgver" build \
-        -Dmangoapp=true \
-        -Dmangohudctl=true
+_light=(-Dmangoapp=false -Dmangohudctl=false -Dmangoplot=disabled -Dwith_xnvctrl=disabled
+        -Dwith_nvml=disabled -Dtests=disabled)
 
+build() {
+    arch-meson "$_pkgname-v$pkgver" build "${_light[@]}"
     meson compile -C build
+
+    # 32-bit, as in Arch's lib32-mangohud PKGBUILD (fmt/spdlog come from the bundled subprojects)
+    (
+        export CC="gcc -m32" CXX="g++ -m32" PKG_CONFIG_PATH="/usr/lib32/pkgconfig"
+        arch-meson "$_pkgname-v$pkgver" build32 "${_light[@]}" -Dinclude_doc=false --libdir lib32
+        meson compile -C build32
+    )
 }
 
-package() {
+package_mangohud-light() {
+    depends=('dbus' 'fmt' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxkbcommon' 'vulkan-icd-loader' 'wayland')
+    provides=("mangohud=$pkgver")
+    conflicts=('mangohud' 'mangoapp')
+
     meson install -C build --destdir "$pkgdir"
 
     install -Dm 0644 "$srcdir/$_pkgname-v$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
     rm --force "$pkgdir/usr/lib/libimgui.a"
 }
 
+package_lib32-mangohud-light() {
+    pkgdesc="32-bit libraries for MangoHud (GPD light build)"
+    depends=('lib32-dbus' 'lib32-gcc-libs' 'lib32-libx11' 'lib32-libxkbcommon' 'lib32-vulkan-icd-loader' 'lib32-wayland')
+    provides=("lib32-mangohud=$pkgver")
+    conflicts=('lib32-mangohud' 'lib32-mangoapp')
+
+    meson install -C build32 --tags runtime --destdir "$pkgdir"
+    rm -rf "$pkgdir/usr/bin"   # (as Arch's lib32-mangohud: the tools come with the 64-bit package)
+
+    install -Dm 0644 "$srcdir/$_pkgname-v$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
+}
+
 check() {
     meson test -C build --print-errorlogs || :
 }
