From: Robin <robinei@gmail.com>
Subject: [PATCH] ASoC: rt5645: restore the codec after resume from hibernation

Hibernation powers the codec off. After the restore its registers hold the power-on values,
and the driver does not bring them back:

 - regcache_sync() skips registers whose cached value equals the reset default in the register
   defaults table (it assumes a freshly reset codec). Some registers (e.g. ASRC_4, 0x8a, default
   0x0120) power up with another value, so the ASRC stays off and the output is static noise.
 - the jack detection setup in probe writes volatile registers (IRQ_CTRL2, A_JD_CTRL1), which
   are not in the cache and so are never restored: the jack interrupt stays off and the jack
   state is stuck at whatever it was.

Use a separate .restore handler: soft reset the codec so the defaults hold, resync the cache and
redo the jack detection setup (now in rt5645_jd_init(), also used by probe).

Seen on a GPD Win (Cherry Trail, cht-bsw-rt5645, kernel 7.2.9): after hibernate the speaker was
silent, the headphones gave static, plugging a jack did nothing.
---
--- a/sound/soc/codecs/rt5645.c	2026-10-09 12:17:05.500811392 +0200
+++ b/sound/soc/codecs/rt5645.c	2026-10-09 12:17:05.504531559 +0200
@@ -3998,6 +3998,61 @@
 }
 EXPORT_SYMBOL_GPL(rt5645_components);
 
+/*
+ * Jack detection setup. Most of it goes to volatile registers (IRQ_CTRL2, A_JD_CTRL1), which are
+ * not in the register cache, so it has to be redone by hand when the codec lost its power.
+ */
+static void rt5645_jd_init(struct rt5645_priv *rt5645)
+{
+	if (rt5645->pdata.jd_mode) {
+		regmap_update_bits(rt5645->regmap, RT5645_GEN_CTRL3,
+				   RT5645_IRQ_CLK_GATE_CTRL,
+				   RT5645_IRQ_CLK_GATE_CTRL);
+		regmap_update_bits(rt5645->regmap, RT5645_MICBIAS,
+				   RT5645_IRQ_CLK_INT, RT5645_IRQ_CLK_INT);
+		regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
+				   RT5645_IRQ_JD_1_1_EN, RT5645_IRQ_JD_1_1_EN);
+		regmap_update_bits(rt5645->regmap, RT5645_GEN_CTRL3,
+				   RT5645_JD_PSV_MODE, RT5645_JD_PSV_MODE);
+		regmap_update_bits(rt5645->regmap, RT5645_HPO_MIXER,
+				   RT5645_IRQ_PSV_MODE, RT5645_IRQ_PSV_MODE);
+		regmap_update_bits(rt5645->regmap, RT5645_MICBIAS,
+				   RT5645_MIC2_OVCD_EN, RT5645_MIC2_OVCD_EN);
+		regmap_update_bits(rt5645->regmap, RT5645_GPIO_CTRL1,
+				   RT5645_GP1_PIN_IRQ, RT5645_GP1_PIN_IRQ);
+		switch (rt5645->pdata.jd_mode) {
+		case 1:
+			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
+					   RT5645_JD1_MODE_MASK,
+					   RT5645_JD1_MODE_0);
+			break;
+		case 2:
+			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
+					   RT5645_JD1_MODE_MASK,
+					   RT5645_JD1_MODE_1);
+			break;
+		case 3:
+		case 4:
+			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
+					   RT5645_JD1_MODE_MASK,
+					   RT5645_JD1_MODE_2);
+			break;
+		default:
+			break;
+		}
+		if (rt5645->pdata.inv_jd1_1) {
+			regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
+				RT5645_JD_1_1_MASK, RT5645_JD_1_1_INV);
+		}
+	}
+
+
+	if (rt5645->pdata.level_trigger_irq) {
+		regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
+			RT5645_JD_1_1_MASK, RT5645_JD_1_1_INV);
+	}
+}
+
 static int rt5645_i2c_probe(struct i2c_client *i2c)
 {
 	struct rt5645_priv *rt5645;
@@ -4200,55 +4255,10 @@
 		break;
 	}
 
-	if (rt5645->pdata.jd_mode) {
-		regmap_update_bits(rt5645->regmap, RT5645_GEN_CTRL3,
-				   RT5645_IRQ_CLK_GATE_CTRL,
-				   RT5645_IRQ_CLK_GATE_CTRL);
-		regmap_update_bits(rt5645->regmap, RT5645_MICBIAS,
-				   RT5645_IRQ_CLK_INT, RT5645_IRQ_CLK_INT);
-		regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
-				   RT5645_IRQ_JD_1_1_EN, RT5645_IRQ_JD_1_1_EN);
-		regmap_update_bits(rt5645->regmap, RT5645_GEN_CTRL3,
-				   RT5645_JD_PSV_MODE, RT5645_JD_PSV_MODE);
-		regmap_update_bits(rt5645->regmap, RT5645_HPO_MIXER,
-				   RT5645_IRQ_PSV_MODE, RT5645_IRQ_PSV_MODE);
-		regmap_update_bits(rt5645->regmap, RT5645_MICBIAS,
-				   RT5645_MIC2_OVCD_EN, RT5645_MIC2_OVCD_EN);
-		regmap_update_bits(rt5645->regmap, RT5645_GPIO_CTRL1,
-				   RT5645_GP1_PIN_IRQ, RT5645_GP1_PIN_IRQ);
-		switch (rt5645->pdata.jd_mode) {
-		case 1:
-			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
-					   RT5645_JD1_MODE_MASK,
-					   RT5645_JD1_MODE_0);
-			break;
-		case 2:
-			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
-					   RT5645_JD1_MODE_MASK,
-					   RT5645_JD1_MODE_1);
-			break;
-		case 3:
-		case 4:
-			regmap_update_bits(rt5645->regmap, RT5645_A_JD_CTRL1,
-					   RT5645_JD1_MODE_MASK,
-					   RT5645_JD1_MODE_2);
-			break;
-		default:
-			break;
-		}
-		if (rt5645->pdata.inv_jd1_1) {
-			regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
-				RT5645_JD_1_1_MASK, RT5645_JD_1_1_INV);
-		}
-	}
+	rt5645_jd_init(rt5645);
 
 	regmap_update_bits(rt5645->regmap, RT5645_ADDA_CLK1,
 		RT5645_I2S_PD1_MASK, RT5645_I2S_PD1_2);
-
-	if (rt5645->pdata.level_trigger_irq) {
-		regmap_update_bits(rt5645->regmap, RT5645_IRQ_CTRL2,
-			RT5645_JD_1_1_MASK, RT5645_JD_1_1_INV);
-	}
 	timer_setup(&rt5645->btn_check_timer, rt5645_btn_check_callback, 0);
 
 	mutex_init(&rt5645->jd_mutex);
@@ -4332,12 +4342,32 @@
 	return 0;
 }
 
-static int rt5645_sys_resume(struct device *dev)
+static int rt5645_do_resume(struct device *dev, bool power_lost)
 {
 	struct rt5645_priv *rt5645 = dev_get_drvdata(dev);
+	int ret;
 
 	regcache_cache_only(rt5645->regmap, false);
-	regcache_sync(rt5645->regmap);
+	if (power_lost) {
+		/*
+		 * The codec has lost its power. It now holds its power-on values, which are not
+		 * the soft reset values that the register defaults table (and so regcache_sync(),
+		 * which skips registers whose cached value equals the default) assumes, e.g.
+		 * ASRC_4. Soft reset it first, so that the defaults hold.
+		 */
+		regmap_write(rt5645->regmap, RT5645_RESET, 0);
+		regcache_mark_dirty(rt5645->regmap);
+	}
+	ret = regcache_sync(rt5645->regmap);
+	if (ret) {
+		regcache_cache_only(rt5645->regmap, true);
+		regcache_mark_dirty(rt5645->regmap);
+		return ret;
+	}
+
+	/* Not cached (volatile registers): redo it, or the jack interrupt stays off */
+	if (power_lost)
+		rt5645_jd_init(rt5645);
 
 	if (rt5645->hp_jack) {
 		rt5645->jack_type = 0;
@@ -4346,8 +4376,24 @@
 	return 0;
 }
 
+static int rt5645_sys_resume(struct device *dev)
+{
+	return rt5645_do_resume(dev, false);
+}
+
+/* Resuming from hibernation: the codec was powered off in the meantime */
+static int rt5645_sys_restore(struct device *dev)
+{
+	return rt5645_do_resume(dev, true);
+}
+
 static const struct dev_pm_ops rt5645_pm = {
-	SYSTEM_SLEEP_PM_OPS(rt5645_sys_suspend, rt5645_sys_resume)
+	.suspend = pm_sleep_ptr(rt5645_sys_suspend),
+	.resume = pm_sleep_ptr(rt5645_sys_resume),
+	.freeze = pm_sleep_ptr(rt5645_sys_suspend),
+	.thaw = pm_sleep_ptr(rt5645_sys_resume),
+	.poweroff = pm_sleep_ptr(rt5645_sys_suspend),
+	.restore = pm_sleep_ptr(rt5645_sys_restore),
 };
 
 static struct i2c_driver rt5645_i2c_driver = {
