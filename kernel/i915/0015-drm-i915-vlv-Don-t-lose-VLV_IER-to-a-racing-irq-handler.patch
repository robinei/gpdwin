From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robin <robinei@gmail.com>
Date: Mon, 12 Oct 2026 07:34:00 +0200
Subject: [PATCH] drm/i915/vlv: Don't lose VLV_IER to a racing irq handler

valleyview_irq_handler() and cherryview_irq_handler() clear VLV_IER while
they run and write back the value they read, without display->irq.lock.
valleyview_enable_display_irqs() (display power well enable) rewrites
VLV_IER under that lock only. A handler running on another CPU at the
same time, e.g. for a GT interrupt, that read VLV_IER before the
postinstall reads 0 (display interrupts were off with the power well)
and writes that 0 back over the new enable mask. Display interrupts then
stay off until the next power well cycle: the pipe runs, but every vblank
wait and flip_done times out.

Seen on a GPD Win 1 (CHV, DSI panel) at screen-on after the output had
been off long enough for the display power well to go down: "vblank wait
timed out on crtc 1" in intel_enable_crtc(), then flip_done timeouts.
The stuck device read VLV_IER 0, VLV_IMR 0xffcd6daf (so the postinstall
had run), VLV_IIR 0x10 latched, pipe B running, no i915 interrupts.
Reproduced with screen off/on cycles under GPU load: 14 lost masks in
300 screen-ons, all restored by this patch.

After enabling, and likewise after disabling (where a racing handler
restores the old mask), make the new VLV_IER value stick: wait for
running handlers, re-read, rewrite it if it was lost, and repeat, since
a handler that started between the wait and the rewrite may have saved
the lost value as well. Each further round needs another handler to
start in that window; the loop is bounded and logs if it ever gives up.
---
 .../gpu/drm/i915/display/intel_display_irq.c  | 58 ++++++++++++++++++-
 1 file changed, 57 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/i915/display/intel_display_irq.c b/drivers/gpu/drm/i915/display/intel_display_irq.c
index 4a821b0..83f2585 100644
--- a/drivers/gpu/drm/i915/display/intel_display_irq.c
+++ b/drivers/gpu/drm/i915/display/intel_display_irq.c
@@ -2318,8 +2318,53 @@ static void ibx_irq_postinstall(struct intel_display *display)
 	irq_init(display, SDE_IRQ_REGS, ~mask, 0xffffffff);
 }
 
+/*
+ * The VLV/CHV irq handlers clear VLV_IER while they run and then write back
+ * the value they read, without display->irq.lock. A handler (say for a GT
+ * interrupt on another CPU) that read VLV_IER before a display irq enable or
+ * disable writes the old value back over the new one: after an enable,
+ * display interrupts then stay off until the next power well cycle and every
+ * vblank wait and flip_done times out. Make the new value stick: wait for
+ * running handlers, re-read, rewrite if it was lost, and repeat (a handler
+ * that started between the wait and the rewrite may have saved the lost
+ * value too), until it holds. Each round needs another handler to start in
+ * that window, so this ends at once in practice; it is bounded anyway.
+ */
+static void vlv_ier_settle(struct intel_display *display, bool enable)
+{
+	int i;
+
+	for (i = 0; i < 5; i++) {
+		u32 want, ier;
+
+		intel_parent_irq_synchronize(display);
+
+		spin_lock_irq(&display->irq.lock);
+		if (display->irq.vlv_display_irqs_enabled != enable ||
+		    !intel_parent_irq_enabled(display)) {
+			spin_unlock_irq(&display->irq.lock);
+			return;
+		}
+		want = enable ? ~display->irq.vlv_imr_mask : 0;
+		ier = intel_de_read(display, VLV_IER);
+		if (ier == want) {
+			spin_unlock_irq(&display->irq.lock);
+			return;
+		}
+		/* a handler running right now also shows 0 here, harmlessly */
+		drm_info(display->drm,
+			 "VLV_IER 0x%08x after display irq %s, restoring 0x%08x\n",
+			 ier, enable ? "enable" : "disable", want);
+		intel_de_write(display, VLV_IER, want);
+		spin_unlock_irq(&display->irq.lock);
+	}
+	drm_err(display->drm, "VLV_IER did not settle after %d rewrites\n", i);
+}
+
 void valleyview_enable_display_irqs(struct intel_display *display)
 {
+	bool installed = false;
+
 	spin_lock_irq(&display->irq.lock);
 
 	if (display->irq.vlv_display_irqs_enabled)
@@ -2330,14 +2375,20 @@ void valleyview_enable_display_irqs(struct intel_display *display)
 	if (intel_parent_irq_enabled(display)) {
 		_vlv_display_irq_reset(display);
 		_vlv_display_irq_postinstall(display);
+		installed = true;
 	}
 
 out:
 	spin_unlock_irq(&display->irq.lock);
+
+	if (installed)
+		vlv_ier_settle(display, true);
 }
 
 void valleyview_disable_display_irqs(struct intel_display *display)
 {
+	bool reset = false;
+
 	spin_lock_irq(&display->irq.lock);
 
 	if (!display->irq.vlv_display_irqs_enabled)
@@ -2345,10 +2396,15 @@ void valleyview_disable_display_irqs(struct intel_display *display)
 
 	display->irq.vlv_display_irqs_enabled = false;
 
-	if (intel_parent_irq_enabled(display))
+	if (intel_parent_irq_enabled(display)) {
 		_vlv_display_irq_reset(display);
+		reset = true;
+	}
 out:
 	spin_unlock_irq(&display->irq.lock);
+
+	if (reset)
+		vlv_ier_settle(display, false);
 }
 
 static void ilk_de_irq_postinstall(struct intel_display *display)
