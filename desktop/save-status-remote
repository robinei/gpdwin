#!/usr/bin/env python3
"""Desktop side of the GPD's game saves tool (scripts/save-status).

The GPD runs this over ssh with a restricted key (authorized_keys forced command), choosing the
action with the ssh command line (SSH_ORIGINAL_COMMAND):

  status [APPID] JSON: size, mtime, SHA-1 of the desktop's save files for every game in
                games/saves.json, the Steam Cloud state of the game, and whether Steam is running.
  get APPID     tar stream on stdout with the game's existing save files. A member is named
                "N" (file entry N of the game's "files" list in games/saves.json) or "N/rel/path"
                (a file inside folder entry N, which has "dir": true).
  discover APPID  JSON: where this machine keeps the game's saves, from Steam's own cloud records
                (userdata/<id>/<appid>/remotecache.vdf) and from the save paths in
                games/save-manifest.json (Ludusavi data) that exist here. Read-only, one app only.
  put APPID     tar stream on stdin in the same format; writes those files (mtime kept). Existing
                files that would be replaced are first copied to ~/save-backups/<time>/<appid>/.

It only ever reads or writes the paths listed in games/saves.json (and below its folder entries);
tar member names are validated and never used as paths. Anything else is refused.
"""
import fnmatch, glob, hashlib, importlib.machinery, importlib.util, io, json, os, re, shutil, subprocess, sys, tarfile, time
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
MAX_FILE = 64 << 20   # bytes per save file
MAX_FILES = 2000      # files per game


def load_cloud():
    loader = importlib.machinery.SourceFileLoader("steamcloud", str(HERE / "steam-cloud-status"))
    spec = importlib.util.spec_from_loader("steamcloud", loader)
    sc = importlib.util.module_from_spec(spec)
    loader.exec_module(sc)
    return sc


def sha1(p):
    h = hashlib.sha1()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def userdata_dirs(sc):
    return [d for d in sorted((sc.STEAM / "userdata").glob("*")) if d.is_dir() and d.name != "0"]


def game_paths(game, sc, userdirs):
    """The desktop path of each entry in the game's "files" list (a file, or a folder if "dir")."""
    out = []
    for f in game["files"]:
        raw = f["desktop"].replace("{steam}", str(sc.STEAM)).replace("{home}", str(Path.home()))
        if "{userdata}" in raw and userdirs:
            raw = raw.replace("{userdata}", str(userdirs[0]))
        out.append(Path(raw))
    return out


def scan(game, bases):
    """Every save file of the game -> [{key, path, exists, size, mtime, sha}].

    key is the tar member name: "N" for file entry N, "N/rel/path" for a file inside folder entry
    N. A file entry that doesn't exist is listed with exists False; a missing folder lists nothing.
    """
    out = []
    for i, (f, base) in enumerate(zip(game["files"], bases)):
        if f.get("dir"):
            if not base.is_dir():
                continue
            ignore = f.get("ignore", [])   # fnmatch patterns on the path inside the folder
            found = [(f"{i}/{p.relative_to(base).as_posix()}", p) for p in sorted(base.rglob("*"))
                     if p.is_file() and not p.is_symlink()
                     and not any(fnmatch.fnmatch(p.relative_to(base).as_posix(), pat) for pat in ignore)]
        else:
            found = [(str(i), base)]
        for key, p in found:
            if p.is_file():
                st = p.stat()
                out.append({"key": key, "path": str(p), "exists": True, "size": st.st_size,
                            "mtime": int(st.st_mtime), "sha": sha1(p)})
            else:
                out.append({"key": key, "path": str(p), "exists": False})
        if len(out) > MAX_FILES:
            raise ValueError("too many files")
    return out


def target_path(game, bases, key):
    """Validate a tar member name and return the path it stands for. Raises ValueError."""
    m = re.fullmatch(r"(\d+)(?:/(.+))?", key)
    if not m or int(m[1]) >= len(bases):
        raise ValueError(f"unexpected member {key!r}")
    i, rel = int(m[1]), m[2]
    if game["files"][i].get("dir"):
        parts = PurePosixPath(rel or "").parts
        if not parts or PurePosixPath(rel).is_absolute() or any(x in ("", ".", "..") for x in parts):
            raise ValueError(f"unexpected member {key!r}")
        return bases[i].joinpath(*parts)
    if rel:
        raise ValueError(f"unexpected member {key!r}")
    return bases[i]


def cloud_state(sc, appid, userdirs, libs):
    """'synced' | 'needs-launch' | 'no-cloud' for one app (same logic as steam-cloud-status)."""
    for userdir in userdirs:
        cache = userdir / appid / "remotecache.vdf"
        if not cache.exists():
            continue
        files = sc.parse_vdf(cache.read_text(errors="replace")).get(appid, {})
        _, install, prefix = sc.app_info(appid, libs)
        for rel, meta in files.items():
            if not isinstance(meta, dict) or set(meta.get("sha", "0")) == {"0"}:
                continue
            path, _ = sc.resolve(int(meta.get("root", 0)), rel, appid, userdir, install, prefix)
            if path is None:
                continue
            if not path.exists() or sha1(path) != meta.get("sha"):
                return "needs-launch"
        return "synced"
    return "no-cloud"


def steam_running():
    return subprocess.run(["pgrep", "-x", "steam"], capture_output=True).returncode == 0


def find_game(cfg, appid):
    for g in cfg["games"]:
        if g["appid"] == appid:
            return g
    raise SystemExit(f"unknown game {appid!r}")


def do_status(cfg, sc, out, only=None):
    """Status of every game, or of one (`only`). An APPID this copy of saves.json doesn't list
    comes back as {"appid", "unknown": true}: the desktop clone needs a git pull."""
    userdirs = userdata_dirs(sc)
    libs = sc.libraries()
    res = {"steam_running": steam_running(), "games": []}
    if only and not any(g["appid"] == only for g in cfg["games"]):
        res["games"].append({"appid": only, "unknown": True})
    for g in cfg["games"]:
        if only and g["appid"] != only:
            continue
        res["games"].append({"appid": g["appid"], "files": scan(g, game_paths(g, sc, userdirs)),
                             "cloud": cloud_state(sc, g["appid"], userdirs, libs)})
    out.write(json.dumps(res).encode())


def do_get(cfg, sc, appid, out):
    game = find_game(cfg, appid)
    with tarfile.open(fileobj=out, mode="w|") as tf:
        for e in scan(game, game_paths(game, sc, userdata_dirs(sc))):
            if not e["exists"]:
                continue
            ti = tf.gettarinfo(e["path"], arcname=e["key"])
            ti.uid = ti.gid = 0
            ti.uname = ti.gname = ""
            with open(e["path"], "rb") as fh:
                tf.addfile(ti, fh)


def read_members(inp, check):
    """Read a tar stream of saves -> {key: (bytes, mtime)}. check(key) validates a member name
    (raises ValueError). Nothing is written here."""
    got = {}
    with tarfile.open(fileobj=inp, mode="r|") as tf:
        for m in tf:
            if not m.isfile():
                raise ValueError(f"unexpected member {m.name!r}")
            check(m.name)
            if m.size > MAX_FILE:
                raise ValueError(f"member {m.name!r} too large")
            if m.name in got:
                raise ValueError(f"duplicate member {m.name!r}")
            if len(got) >= MAX_FILES:
                raise ValueError("too many files")
            got[m.name] = (tf.extractfile(m).read(), int(m.mtime))
    return got


def write_files(target, got, backup_dir):
    """Write {key: (data, mtime)} to target(key); back up anything replaced under backup_dir/key.
    Returns the written paths."""
    written = []
    for key, (data, mtime) in sorted(got.items()):
        p = target(key)
        if p.is_file() and p.read_bytes() == data:
            continue   # identical content: leave it (and its mtime) alone
        p.parent.mkdir(parents=True, exist_ok=True)
        if p.exists():
            b = backup_dir / key
            b.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, b)
        tmp = p.with_name(p.name + ".gpd-tmp")
        tmp.write_bytes(data)
        os.utime(tmp, (mtime, mtime))
        os.replace(tmp, p)
        written.append(str(p))
    return written


def do_put(cfg, sc, appid, inp, out):
    game = find_game(cfg, appid)
    bases = game_paths(game, sc, userdata_dirs(sc))
    got = read_members(inp, lambda k: target_path(game, bases, k))
    backup = Path.home() / "save-backups" / time.strftime("%Y%m%d-%H%M%S") / appid
    out.write(json.dumps({"written": write_files(lambda k: target_path(game, bases, k), got, backup)}).encode())


def expand_candidate(raw, os_, install, prefix):
    """Manifest path -> concrete path on this machine, or None if it needs something we don't have."""
    home = Path.home()
    if os_ == "linux":
        toks = {"<xdgConfig>": home / ".config", "<xdgData>": home / ".local/share", "<home>": home}
    elif os_ == "windows" and prefix:
        toks = {"<home>": prefix, "<winAppData>": prefix / "AppData/Roaming",
                "<winLocalAppData>": prefix / "AppData/Local", "<winDocuments>": prefix / "Documents"}
    else:
        toks = {}
    if install:
        toks["<base>"] = install
    for tok, rep in toks.items():
        raw = raw.replace(tok, str(rep))
    return None if "<" in raw else raw


def match_cloud(candidates, rel, root_dirs):
    """Desktop path of cloud file `rel` (relative to its Steam root) under an existing candidate:
    candidate dir B matches when the last k components of B equal the first k of rel
    (B=~/.config/StardewValley/Saves, rel=StardewValley/Saves/Farm/x -> B/Farm/x), or when rel
    sits directly below a root dir. Returns a path that exists, or None."""
    rparts = Path(rel).parts
    for b in candidates:
        bp = Path(b)
        if not bp.is_dir():
            continue
        for k in range(len(rparts) - 1, 0, -1):
            if [x.lower() for x in bp.parts[-k:]] == [x.lower() for x in rparts[:k]]:
                q = bp.joinpath(*rparts[k:])
                if q.is_file():
                    return q
    for d in root_dirs:
        q = d / rel
        if q.is_file():
            return q
    return None


def template(path, sc, userdirs):
    """Absolute path on this machine -> the {userdata}/{steam}/{home} form used in saves.json."""
    if path is None:
        return None
    path = str(path)
    for rep, base in (("{userdata}", userdirs[0] if userdirs else None), ("{steam}", sc.STEAM), ("{home}", Path.home())):
        if base and path.startswith(str(base) + "/"):
            return rep + path[len(str(base)):]
    return path


def do_discover(sc, appid, out):
    manifest = json.loads((REPO / "games/save-manifest.json").read_text()) if (REPO / "games/save-manifest.json").exists() else {}
    libs = sc.libraries()
    name, install, prefix = sc.app_info(appid, libs)
    cands, exist_dirs = [], []
    for raw, spec in (manifest.get(appid, {}).get("files") or {}).items():
        for os_ in spec["os"]:
            if os_ not in ("linux", "windows", "any"):
                continue
            path = expand_candidate(raw, "linux" if os_ == "any" else os_, install, prefix)
            if not path:
                continue
            hits = glob.glob(path) if any(c in path for c in "*?[") else ([path] if os.path.exists(path) else [])
            cands.append({"manifest": raw, "os": os_, "path": path, "exists": bool(hits)})
            if hits and "*" not in path:
                exist_dirs.append(path)
    cloud = []
    for userdir in userdata_dirs(sc):
        cache = userdir / appid / "remotecache.vdf"
        if not cache.exists():
            continue
        files = sc.parse_vdf(cache.read_text(errors="replace")).get(appid, {})
        for rel, meta in files.items():
            if not isinstance(meta, dict) or set(meta.get("sha", "0")) == {"0"}:
                continue
            root = int(meta.get("root", 0))
            resolved, note = sc.resolve(root, rel, appid, userdir, install, prefix)
            root_dirs = []
            if resolved is not None:
                root_dirs = [Path(str(resolved)[: len(str(resolved)) - len(rel)].rstrip("/"))]
            m = match_cloud(exist_dirs, rel, root_dirs)
            cloud.append({"rel": rel, "root": root, "resolved": str(resolved) if resolved else None,
                          "note": note, "match": str(m) if m else None})
        break
    ud = userdata_dirs(sc)
    for c in cands:
        c["path_t"] = template(c["path"], sc, ud)
    for c in cloud:
        c["match_t"] = template(c["match"], sc, ud)
    out.write(json.dumps({"appid": appid, "name": name, "install": str(install) if install else None,
                          "proton": bool(prefix), "candidates": cands, "cloud": cloud}).encode())


def main():
    cfg = json.loads((REPO / "games/saves.json").read_text())
    sc = load_cloud()
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "status").split()
    out = sys.stdout.buffer
    try:
        if cmd == ["status"]:
            do_status(cfg, sc, out)
        elif len(cmd) == 2 and cmd[0] == "status":
            do_status(cfg, sc, out, cmd[1])
        elif len(cmd) == 2 and cmd[0] == "discover":
            do_discover(sc, cmd[1], out)
        elif len(cmd) == 2 and cmd[0] == "get":
            do_get(cfg, sc, cmd[1], out)
        elif len(cmd) == 2 and cmd[0] == "put":
            do_put(cfg, sc, cmd[1], sys.stdin.buffer, out)
        else:
            print("usage: status [APPID] | discover APPID | get APPID | put APPID", file=sys.stderr)
            return 2
    except (ValueError, tarfile.TarError, OSError) as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    out.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
