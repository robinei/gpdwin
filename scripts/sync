#!/usr/bin/env python3
"""Keep live config files and the ~/gpd repo in step.

The files come in layers (docs/repo-layout.md, scripts/layers.py): the common components named in the host file
~/.config/gpd/host (components/<name>/manifest.tsv), then the device's (devices/<device>/manifest.tsv), then the
user's (users/<user>/manifest.tsv). Repo paths in a manifest are relative to its layer's root (the repo root for
components). A later layer may list the same live path again and wins (a user's setting over a default).

Each manifest.tsv lists the files its layer manages:
  link  <repo path>  <live path>                  live path is a symlink into the repo
  copy  <repo path>  <live path>  <owner:group:mode>  repo holds a copy (root-owned files)
  keep  <repo path>  <live path>  <owner:group:mode>  like copy, for files a program rewrites itself
                                                      (settings saved from its menu); synced both ways
                                                      (below)
  build <repo path>  <live path>  [pkg-config packages]
                                                  a C source compiled to the live path
                                                      (rebuilt when the source is newer), linked
                                                      against the space-separated packages
  dkms  <prepare script>  <package>/<version>  <input paths...>
                                                  a DKMS kernel module package: `prepare script <package>` builds
                                                      its source tree in dkms-tree/<package>-<version>/ next to the
                                                      script; install copies it to /usr/src and builds it for every
                                                      kernel with headers. Reinstalled when the script or the input
                                                      paths (patches, pinned source lists) change.
owner "user" means whoever runs sync. A copy whose repo file contains @USER@ or @ROOT_UUID@ gets the user name
or the root file system's UUID put in on install (edit those in the repo; capture refuses them).

Commands:
  sync check            report drift (missing/foreign links, copies that differ). Exit 1 on drift.
  sync diff [PATH..]    show unified diffs for drifted copies
  sync capture [PATH..] copy live -> repo for copy entries (all, or those matching PATH)
  sync install [--force] [PATH..]
                        repo -> live: create links, install copies (sudo for root files); keep
                        entries only when missing (or with --force)

keep entries remember the content of their last sync ("base", a sha256 per live path) in
~/.local/state/gpd-sync/bases.json on this machine, so check/install can say which side changed
since then (without a base, live counts as changed). They never resolve a difference themselves:
that is decided with the user (CLAUDE.md): `capture` (live wins), `install --force` (repo wins), or
a hand merge followed by either.
  sync adopt            first-time setup: move live files into the repo and link them
  sync list             every managed live path with its layer
  sync packages         the official packages the layers need (for `sudo pacman -S --needed $(scripts/sync packages)`)
  sync services         the systemd units the layers enable; "user NAME" lines are --user units

Root files are read and written with `sudo -n`, so run `sudo -v` in a terminal first.
"""
import difflib, getpass, hashlib, json, os, shutil, subprocess, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import layers  # noqa: E402

REPO = layers.REPO
HOME = Path.home()
USER = getpass.getuser()
BASES = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "gpd-sync" / "bases.json"


def rel(p):
    """A repo path for messages: relative to the repo when it's inside it."""
    try:
        return p.relative_to(REPO)
    except ValueError:
        return p


def expand(p):
    return Path(os.path.expanduser(p))


def manifest():
    """All entries of all layers; for a live path listed by several layers, the last layer's entry."""
    by_live = {}
    for label, root, path in layers.layers():
        if not path.exists():
            sys.exit(f"{label}: {path} is missing (host file {layers.HOST})")
        for n, line in enumerate(path.read_text().splitlines(), 1):
            if not line.strip() or line.startswith("#"):
                continue
            f = line.split("\t")
            if f[0] == "link" and len(f) == 3:
                e = {"kind": "link", "repo": root / f[1], "live": expand(f[2])}
            elif f[0] == "build" and len(f) in (3, 4):
                e = {"kind": "build", "repo": root / f[1], "live": expand(f[2]),
                     "pkgs": f[3].split() if len(f) == 4 else []}
            elif f[0] == "dkms" and len(f) == 4 and "/" in f[2]:
                name, ver = f[2].split("/", 1)
                e = {"kind": "dkms", "repo": root / f[1], "name": name, "ver": ver,
                     "inputs": [root / x for x in f[3].split()], "live": Path(f"/usr/src/{name}-{ver}")}
            elif f[0] in ("copy", "keep") and len(f) == 4:
                owner, group, mode = f[3].split(":")
                e = {"kind": "copy", "keep": f[0] == "keep", "repo": root / f[1], "live": expand(f[2]),
                     "owner": USER if owner == "user" else owner, "group": USER if group == "user" else group,
                     "mode": mode}
            else:
                sys.exit(f"{path}:{n}: bad line: {line!r}")
            e["layer"] = label
            by_live[str(e["live"])] = e
    return list(by_live.values())


def need_device():
    """install changes the system: without a device layer it would leave the hardware fixes out."""
    if not layers.device_dir():
        sys.exit(f"no device in {layers.HOST}: create it first, e.g.\n"
                 f"  device=gpd-win1\n  user=yourname\n  components={' '.join(layers.DEFAULT)}\n"
                 f"(devices: {', '.join(p.name for p in sorted((REPO / 'devices').glob('*')))}; docs/repo-layout.md)")


_root_uuid = None


def root_uuid():
    """The root file system's UUID (for boot entries: @ROOT_UUID@)."""
    global _root_uuid
    if _root_uuid is None:
        r = subprocess.run(["findmnt", "-no", "UUID", "/"], capture_output=True, text=True)
        _root_uuid = r.stdout.strip() if r.returncode == 0 else ""
    return _root_uuid


def repo_data(e):
    """The repo file's content as it is installed: @USER@ replaced by the user's name, @ROOT_UUID@ by the
    root file system's UUID."""
    data = e["repo"].read_bytes()
    if e["kind"] != "copy":
        return data
    if b"@ROOT_UUID@" in data:
        if not root_uuid():
            sys.exit(f"{e['repo']}: needs the root file system's UUID, but findmnt found none")
        data = data.replace(b"@ROOT_UUID@", root_uuid().encode())
    return data.replace(b"@USER@", USER.encode())


def templated(e):
    raw = e["repo"].read_bytes()
    return e["kind"] == "copy" and (b"@USER@" in raw or b"@ROOT_UUID@" in raw)


def selected(entries, args):
    if not args:
        return entries
    out = [e for e in entries if any(a in str(e["live"]) or a in str(e["repo"]) for a in args)]
    if not out:
        sys.exit(f"no manifest entry matches {args}")
    return out


def is_root(e):
    return e["kind"] == "copy" and e["owner"] == "root"


class NeedSudo(Exception):
    pass


def read_live(e):
    p = e["live"]
    if not os.path.lexists(p) and not is_root(e):
        return None
    try:
        return p.read_bytes()
    except PermissionError:
        r = subprocess.run(["sudo", "-n", "cat", str(p)], capture_output=True)
        if r.returncode != 0:
            if b"No such file" in r.stderr:
                return None
            raise NeedSudo(f"cannot read {p} (run `sudo -v` first): {r.stderr.decode().strip()}")
        return r.stdout
    except FileNotFoundError:
        return None


def build_ok(e):
    """Built and newer than its source and the headers next to it (src/devconf.h)."""
    if not e["live"].exists() or e["live"].stat().st_size == 0:  # 0 bytes: a build cut off by a power loss
        return False
    newest = max([e["repo"].stat().st_mtime] + [h.stat().st_mtime for h in e["repo"].parent.glob("*.h")])
    return e["live"].stat().st_mtime >= newest


def dkms_inputs(e):
    """sha256 over the prepare script and every file below the input paths: what the built tree depends on."""
    h = hashlib.sha256()
    files = [e["repo"]]
    for p in e["inputs"]:
        files += sorted(x for x in p.rglob("*") if x.is_file()) if p.is_dir() else [p]
    for f in files:
        h.update(str(rel(f)).encode() + b"\0" + f.read_bytes() + b"\0")
    return h.hexdigest()


def dkms_kernels():
    """Installed kernels that can build modules (headers present)."""
    return sorted(p.name for p in Path("/usr/lib/modules").glob("*") if (p / "build").exists())


def dkms_state(e):
    """"ok", or why the package needs installing."""
    stamp = e["live"] / ".gpd-inputs"
    if not stamp.exists():
        return "missing" if not e["live"].exists() else "installed by hand (no stamp)"
    if stamp.read_text().strip() != dkms_inputs(e):
        return "outdated (patches or sources changed)"
    r = subprocess.run(["dkms", "status", "-m", e["name"], "-v", e["ver"]], capture_output=True, text=True)
    built = {line.split(",")[1].strip() for line in r.stdout.splitlines()
             if line.startswith(f"{e['name']}/{e['ver']},") and ": installed" in line}
    missing = [k for k in dkms_kernels() if k not in built]
    return f"not built for {', '.join(missing)}" if missing else "ok"


def dkms_install(e):
    name, ver = e["name"], e["ver"]
    subprocess.run([str(e["repo"]), name], check=True)
    tree = e["repo"].parent / "dkms-tree" / f"{name}-{ver}"
    dest = str(e["live"])
    sudo = ["sudo", "-n"]
    subprocess.run(sudo + ["dkms", "remove", f"{name}/{ver}", "--all"], capture_output=True)
    subprocess.run(sudo + ["rm", "-rf", dest], check=True)
    subprocess.run(sudo + ["cp", "-a", str(tree), dest], check=True)
    subprocess.run(sudo + ["tee", f"{dest}/.gpd-inputs"], input=dkms_inputs(e) + "\n", text=True,
                   stdout=subprocess.DEVNULL, check=True)
    subprocess.run(sudo + ["dkms", "add", f"{name}/{ver}"], check=True)
    for k in dkms_kernels():
        subprocess.run(sudo + ["dkms", "install", f"{name}/{ver}", "-k", k], check=True)
    print(f"installed DKMS {name}/{ver} for {', '.join(dkms_kernels())}")


def link_ok(e):
    return e["live"].is_symlink() and Path(os.readlink(e["live"])) == e["repo"]


def sha(data):
    return hashlib.sha256(data).hexdigest()


def load_bases():
    try:
        return json.loads(BASES.read_text())
    except (FileNotFoundError, ValueError):
        return {}


def save_bases(bases):
    BASES.parent.mkdir(parents=True, exist_ok=True)
    tmp = BASES.with_suffix(".tmp")
    tmp.write_text(json.dumps(bases, indent=1, sort_keys=True) + "\n")
    tmp.replace(BASES)


def keep_state(e, live, bases):
    """Which side of a keep entry changed since its last sync: same, missing, live, repo, conflict."""
    repo = repo_data(e)
    if live is None:
        return "missing"
    if live == repo:
        return "same"
    base = bases.get(str(e["live"]))
    if base is None or sha(repo) == base:
        return "live"
    if sha(live) == base:
        return "repo"
    return "conflict"


# keep differences are never resolved automatically: the session shows `sync diff` to the user and,
# with their go-ahead, runs `capture` (live -> repo) or `install --force` (repo -> live), or merges by hand.
KEEP_MSG = {"live": "live changed since last sync (program saved settings); `sync capture` takes it into the repo",
            "repo": "repo changed since last sync; `sync install --force` applies it",
            "conflict": "both changed since last sync; merge, or capture (live wins) / install --force (repo wins)"}


def check(args):
    drift = skipped = 0
    bases = load_bases()
    for e in selected(manifest(), args):
        if not os.path.lexists(e["repo"]):
            print(f"MISSING-IN-REPO  {rel(e['repo'])}"); drift += 1
        elif e["kind"] == "link":
            if not link_ok(e):
                state = "not a symlink" if os.path.lexists(e["live"]) else "missing"
                print(f"LINK {state:14} {e['live']}"); drift += 1
        elif e["kind"] == "build":
            if not build_ok(e):
                state = "outdated" if e["live"].exists() else "missing"
                print(f"BUILD {state:12} {e['live']}"); drift += 1
        elif e["kind"] == "dkms":
            state = dkms_state(e)
            if state != "ok":
                print(f"DKMS {e['name']}/{e['ver']}: {state}"); drift += 1
        else:
            try:
                live = read_live(e)
            except NeedSudo:
                skipped += 1
                continue
            if live is None:
                print(f"COPY missing      {e['live']}"); drift += 1
            elif live != repo_data(e):
                if e["keep"]:
                    print(f"KEEP {e['live']}: {KEEP_MSG[keep_state(e, live, bases)]}")
                else:
                    print(f"COPY differs      {e['live']}")
                drift += 1
    if not layers.device_dir():
        print(f"note: no device layer ({layers.HOST} has no device=), so its files weren't checked")
    print("no drift" if not drift else f"{drift} item(s) drifted (`sync diff`, then `sync capture` or `sync install`; KEEP: decide with the user, CLAUDE.md)")
    if skipped:
        print(f"{skipped} root-only file(s) not checked: run `sudo -v` first")
    return 1 if drift else 0


def diff(args):
    for e in selected(manifest(), args):
        if e["kind"] != "copy" or not e["repo"].exists():
            continue
        live = read_live(e)
        if live is None or live == repo_data(e):
            continue
        a = repo_data(e).decode(errors="replace").splitlines(keepends=True)
        b = live.decode(errors="replace").splitlines(keepends=True)
        sys.stdout.writelines(difflib.unified_diff(a, b, f"repo/{rel(e['repo'])}", f"live:{e['live']}"))
    return 0


def capture(args):
    bases = load_bases()
    for e in selected(manifest(), args):
        if e["kind"] != "copy":
            continue
        live = read_live(e)
        if live is None:
            print(f"skip (live missing) {e['live']}"); continue
        if templated(e):
            if live != repo_data(e):
                print(f"skip (a template: edit the repo file, then install) {e['live']}")
            continue
        e["repo"].parent.mkdir(parents=True, exist_ok=True)
        if not e["repo"].exists() or e["repo"].read_bytes() != live:
            e["repo"].write_bytes(live)
            print(f"captured {e['live']}")
        if e["keep"]:
            bases[str(e["live"])] = sha(live)
    save_bases(bases)
    return 0


def install(args):
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    if force and not args:
        sys.exit("install --force needs the PATH(s) to overwrite: it replaces live settings")
    hints = set()
    need_device()
    bases = load_bases()
    for e in selected(manifest(), args):
        live = e["live"]
        if e["kind"] == "link":
            if link_ok(e):
                continue
            if live.is_symlink() and os.readlink(live).startswith(str(REPO) + "/"):
                live.unlink()  # a link into the repo from before a file moved there: just re-point it
            elif os.path.lexists(live):
                backup = live.with_name(live.name + ".pre-gpd")
                os.rename(live, backup)
                print(f"moved existing {live} -> {backup}")
            live.parent.mkdir(parents=True, exist_ok=True)
            live.symlink_to(e["repo"])
            print(f"linked {live}")
            continue
        if e["kind"] == "dkms":
            if dkms_state(e) == "ok":
                continue
            dkms_install(e)
            hints.add("sudo mkinitcpio -P, then reboot: new kernel modules are used from the next boot")
            continue
        if e["kind"] == "build":
            if build_ok(e):
                continue
            live.parent.mkdir(parents=True, exist_ok=True)
            flags = []
            if e["pkgs"]:
                flags = subprocess.run(["pkg-config", "--cflags", "--libs"] + e["pkgs"], check=True,
                                       capture_output=True, text=True).stdout.split()
            subprocess.run(["cc", "-O2", "-Wall", "-Wextra", "-o", str(live), str(e["repo"])] + flags, check=True)
            print(f"built {live}")
            hints.add(f"restart {live.name} (see docs/desktop.md)")
            continue
        data = repo_data(e)
        live_data = read_live(e)
        if e["keep"]:
            state = keep_state(e, live_data, bases)
            if state == "same":
                bases[str(live)] = sha(data)
                continue
            if state != "missing" and not force:
                print(f"left alone {live}: {KEEP_MSG[state]}")
                continue
        elif live_data == data:
            continue
        if "sudoers" in str(live):
            r = subprocess.run(["visudo", "-cf", "-"], input=data.decode(), capture_output=True, text=True)
            if r.returncode != 0:
                sys.exit(f"refusing to install invalid sudoers file {e['repo']}: {r.stdout}{r.stderr}")
        src = str(e["repo"])
        if templated(e):  # install the filled-in text from a temporary file
            tmp = HOME / ".cache" / "gpd-sync.tmp"
            tmp.parent.mkdir(parents=True, exist_ok=True)
            tmp.write_bytes(data)
            src = str(tmp)
        cmd = ["install", "-D", "-m", e["mode"], "-o", e["owner"], "-g", e["group"], src, str(live)]
        if is_root(e):
            cmd = ["sudo", "-n"] + cmd
        elif e["owner"] == USER:
            cmd = ["install", "-D", "-m", e["mode"], src, str(live)]
        subprocess.run(cmd, check=True)
        print(f"installed {live}")
        if e["keep"]:
            bases[str(live)] = sha(data)
        s = str(live)
        if s.startswith("/etc/systemd"): hints.add("sudo systemctl daemon-reload (and restart the affected unit)")
        if "udev/rules.d" in s: hints.add("sudo udevadm control --reload")
        if s == "/etc/mkinitcpio.conf": hints.add("sudo mkinitcpio -P")
        if "sshd_config" in s: hints.add("sudo systemctl reload sshd")
        if "/.config/sway/" in s: hints.add("swaymsg reload")
    save_bases(bases)
    for h in sorted(hints):
        print(f"next: {h}")
    return 0


def adopt(args):
    """Move live link-targets into the repo (if the repo has no copy yet), then link; capture copies."""
    for e in manifest():
        if e["kind"] == "link":
            if link_ok(e):
                continue
            if os.path.lexists(e["repo"]):
                if os.path.lexists(e["live"]):
                    print(f"conflict: both {e['repo']} and {e['live']} exist; resolve by hand")
                    continue
            elif os.path.lexists(e["live"]):
                e["repo"].parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(e["live"]), str(e["repo"]))
                print(f"moved {e['live']} -> {rel(e['repo'])}")
            else:
                print(f"skip (nothing to adopt) {e['live']}"); continue
            e["live"].parent.mkdir(parents=True, exist_ok=True)
            e["live"].symlink_to(e["repo"])
            print(f"linked {e['live']}")
    return capture([])


def listing(args):
    for e in sorted(selected(manifest(), args), key=lambda e: str(e["live"])):
        print(f"{e['kind']:5} {e['layer']:22} {e['live']}")
    return 0


def packages(args):
    print("\n".join(layers.packages()))
    return 0


def services(args):
    print("\n".join(layers.services()))
    return 0


def main():
    cmds = {"packages": packages, "services": services, "check": check, "diff": diff, "capture": capture, "install": install, "adopt": adopt, "list": listing}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__); return 2
    try:
        return cmds[sys.argv[1]](sys.argv[2:])
    except NeedSudo as err:
        sys.exit(str(err))


if __name__ == "__main__":
    sys.exit(main())
