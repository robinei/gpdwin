#!/bin/bash
# Start a Claude Code maintenance session in ~/gpd (Pegasus: Utilities > Maintenance).
# Asks for the sudo password once and keeps the (global) sudo timestamp fresh while Claude runs,
# so Claude's non-interactive `sudo -n` commands work. Only one maintenance run at a time.
set -u
export PATH="$HOME/.local/bin:$PATH"   # claude; sway's env may lack it
cd "$(dirname "$0")/.."
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/gpd-maintenance.lock"
flock -n 9 || { echo "Another maintenance run is active."; read -rp "Press Enter " _r; exit 1; }

echo "Maintenance session: sudo password is needed once."
sudo -v || exit 1
( while sleep 60; do sudo -n -v 2>/dev/null || exit; done ) &
keepalive=$!
trap 'kill $keepalive 2>/dev/null; sudo -k' EXIT

claude "${1:-/maintain}"

read -rp "Session ended. Press Enter to return " _r
