#!/usr/bin/env python3
"""Game saves: compare this GPD's saves with the desktop's and copy either way, per game.

Full-screen curses UI (shelf: Utilities > Game Saves). Reads games/saves.json; the desktop's
side comes over ssh from desktop/save-status-remote (restricted key: it can only run that script,
which only touches the paths in saves.json and backs up what it overwrites). Steam Cloud is read
directly with scripts/steam-cloud (read-only: needs `steam-cloud login` once); the cloud can only be
pulled from. To get a save into the cloud: push GPD -> desktop, then start the game in Steam there.
Local files are backed up to ~/save-backups/<time>/<appid>/ before they are overwritten.

  save-status            the UI
  save-status --list     print the table and exit
"""
import curses, importlib.machinery, importlib.util, io, json, os, subprocess, sys, tarfile, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# Reuse the desktop script's tar validation and file writing (same format both ways).
_loader = importlib.machinery.SourceFileLoader("saveremote", str(REPO / "desktop/save-status-remote"))
_spec = importlib.util.spec_from_loader("saveremote", _loader)
remote = importlib.util.module_from_spec(_spec)
_loader.exec_module(remote)

SAME, GPD_NEWER, OTHER_NEWER, ONLY_GPD, ONLY_OTHER, MIXED, NONE, UNKNOWN = (
    "same", "gpd-newer", "other-newer", "only-gpd", "only-other", "differ", "none", "unknown")


def text(code, other):
    """Display text of a state code; `other` is "desktop" or "cloud"."""
    return {SAME: "in sync", GPD_NEWER: "GPD newer", OTHER_NEWER: f"{other} newer",
            ONLY_GPD: "only on GPD", ONLY_OTHER: f"only {'on desktop' if other == 'desktop' else 'in cloud'}",
            MIXED: "differ", NONE: "no saves", UNKNOWN: f"no {other} info"}[code]


DESK_CLOUD = {"synced": "in sync", "needs-launch": "needs Steam launch", "no-cloud": "no cloud data", None: ""}
SSH = ["ssh", "-4", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5"]


def when(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if ts else "-"


# ----- desktop transport -----
class Desktop:
    def __init__(self, host):
        self.host = host

    def _run(self, cmd, data=None):
        try:
            r = subprocess.run(SSH + [self.host, cmd], input=data, capture_output=True, timeout=120)
        except subprocess.TimeoutExpired:
            raise RuntimeError("desktop timed out")
        if r.returncode != 0:
            err = r.stderr.decode(errors="replace").strip().splitlines()
            msg = err[-1] if err else "ssh failed"
            raise RuntimeError(self.OLD if msg.startswith("usage:") else msg)
        return r.stdout

    def status(self, appid):
        """One game's desktop state (dict with "files", "cloud"; or "unknown": true), steam_running."""
        d = json.loads(self._run(f"status {appid}"))
        games = [g for g in d["games"] if g["appid"] == appid]
        if len(games) != 1 or any("key" not in f for f in games[0].get("files", [])):
            raise RuntimeError(self.OLD)
        return games[0], d.get("steam_running", False)

    OLD = "the desktop's save-status-remote is out of date: git pull in ~/Code/gpdwin there"

    def get(self, appid):
        data = self._run(f"get {appid}")
        if data.startswith(b'{"games"'):   # old script ignores the command and prints status
            raise RuntimeError(self.OLD)
        return data

    def put(self, appid, data):
        try:
            return json.loads(self._run(f"put {appid}", data))["written"]
        except (KeyError, ValueError):
            raise RuntimeError(self.OLD)


class Cloud:
    """Steam Cloud, read-only, through scripts/steam-cloud."""
    CMD = str(REPO / "scripts/steam-cloud")

    def _run(self, *args):
        try:
            r = subprocess.run([self.CMD, *args], capture_output=True, text=True, timeout=180)
        except subprocess.TimeoutExpired:
            raise RuntimeError("Steam Cloud timed out")
        if r.returncode != 0:
            err = r.stderr.strip().splitlines()
            raise RuntimeError(err[-1] if err else "steam-cloud failed")
        return r.stdout

    def list_many(self, appids):
        return json.loads(self._run("list-many", *appids))

    def download(self, appid, dest, names=()):
        """Download the named cloud files (all if none given); returns the manifest list."""
        args = ["download", appid, str(dest)]
        for n in names:
            args += ["--only", n]
        self._run(*args)
        return json.loads((Path(dest) / "manifest.json").read_text())


# ----- save data -----
def gpd_bases(game):
    return [Path(os.path.expanduser(f["gpd"])) for f in game["files"]]


def local_files(game):
    return remote.scan(game, gpd_bases(game))


def label(e):
    """Name to show for a scanned file: the path inside its folder, or the file name."""
    return e["key"].split("/", 1)[1] if "/" in e["key"] else Path(e["path"]).name


def pair_code(lf, of):
    """State of one file on the GPD (lf) versus another source (of); either may be None."""
    if lf is None and of is None:
        return NONE   # the file exists in neither (only in a third source)
    if of is None:
        return ONLY_GPD
    if lf is None:
        return ONLY_OTHER
    if lf["sha"] == of["sha"]:
        return SAME
    if lf["mtime"] > of["mtime"]:
        return GPD_NEWER
    if lf["mtime"] < of["mtime"]:
        return OTHER_NEWER
    return MIXED


def overall(codes, known):
    codes = set(codes)
    if not known:
        return UNKNOWN
    if not codes:
        return NONE
    if codes == {SAME}:
        return SAME
    codes.discard(SAME)
    return codes.pop() if len(codes) == 1 else MIXED


def cloud_key(game, name):
    """Entry key (as in scan()) of a Steam Cloud file name, or None if the game doesn't track it."""
    for i, f in enumerate(game["files"]):
        c = f.get("cloud")
        if not c:
            continue
        if f.get("dir"):
            if name.startswith(c) and len(name) > len(c):
                return f"{i}/{name[len(c):]}"
        elif name == c:
            return str(i)
    return None


def cloud_entries(game, files):
    out = []
    for cf in files:
        key = cloud_key(game, cf["filename"])
        if key:
            out.append({"key": key, "path": cf["filename"], "exists": True, "size": cf["size"],
                        "mtime": cf["mtime"], "sha": cf["sha1"]})
    return out


def file_rows(local, desk, cloud):
    """Per-file rows over the union of keys: dicts with the three files and both state codes.
    desk / cloud may be None (unknown). Files that differ somewhere come first."""
    maps = [{e["key"]: e for e in (src or []) if e["exists"]} for src in (local, desk, cloud)]
    rows = []
    for key in sorted(set().union(*[m.keys() for m in maps])):
        lf, df, cf = (m.get(key) for m in maps)
        e = lf or df or cf
        rows.append({"name": label(e), "gpd": lf, "desk": df, "cloud": cf,
                     "dcode": pair_code(lf, df) if desk is not None else UNKNOWN,
                     "ccode": pair_code(lf, cf) if cloud is not None else UNKNOWN})
    quiet = (SAME, UNKNOWN, NONE)
    rows.sort(key=lambda r: r["dcode"] in quiet and r["ccode"] in quiet)
    return rows


def newest(files):
    return max((f["mtime"] for f in files or [] if f.get("exists")), default=0)


def scan_game(g, dt, cloud_files, cloud_err, fail=None):
    """One game's entry. `fail` (an earlier desktop connection error) skips asking the desktop again.
    "err" is set when the desktop side is unknown (unreachable, old script, or the desktop's
    saves.json doesn't list the game); "cloud_err" when Steam Cloud couldn't be read."""
    local = local_files(g)
    rem, steam, err = None, None, fail
    if not fail:
        try:
            r, steam = dt.status(g["appid"])
            if r.get("unknown"):
                err = "the desktop doesn't know this game: git pull in ~/Code/gpdwin there"
            else:
                rem = r
        except (RuntimeError, ValueError, KeyError, OSError) as e:
            err = str(e)
    desk = rem["files"] if rem else None
    cloud = cloud_entries(g, cloud_files[g["appid"]]) if cloud_files and g["appid"] in cloud_files else None
    rows = file_rows(local, desk, cloud)
    return {"game": g, "local": local, "remote": desk, "cloud": cloud, "rows": rows,
            "state": overall([r["dcode"] for r in rows if r["dcode"] not in (UNKNOWN, NONE)], desk is not None),
            "cstate": overall([r["ccode"] for r in rows if r["ccode"] not in (UNKNOWN, NONE)], cloud is not None),
            "desk_cloud": DESK_CLOUD.get(rem.get("cloud"), "") if rem else "",
            "err": err, "cloud_err": cloud_err if cloud is None else None, "steam": steam,
            "conn_failed": bool(err and not (rem or "doesn't know" in err))}


def load(cfg, dt, cloud, progress=None):
    """Scan every game (asking the desktop about each one separately; Steam Cloud once) -> entries."""
    cloud_files, cloud_err = None, None
    if progress:
        progress("Steam Cloud", [])
    try:
        cloud_files = cloud.list_many([g["appid"] for g in cfg["games"] if any(f.get("cloud") for f in g["files"])])
    except (RuntimeError, ValueError, OSError) as e:
        cloud_err = str(e)
    entries, fail = [], None
    for g in cfg["games"]:
        if progress:
            progress(g["name"], entries)
        e = scan_game(g, dt, cloud_files, cloud_err, fail)
        if e["conn_failed"]:
            fail = e["err"]
        entries.append(e)
    return entries


def backup_dir(appid):
    return Path.home() / "save-backups" / time.strftime("%Y%m%d-%H%M%S") / appid


def pull(entry, dt):
    """Desktop -> GPD: every save file the desktop has. Returns number of files written."""
    g = entry["game"]
    bases = gpd_bases(g)
    target = lambda k: remote.target_path(g, bases, k)
    got = remote.read_members(io.BytesIO(dt.get(g["appid"])), target)
    return len(remote.write_files(target, got, backup_dir(g["appid"])))


def pull_cloud(entry, cloud):
    """Steam Cloud -> GPD: every tracked file the cloud has. Returns number of files written."""
    import tempfile
    g = entry["game"]
    bases = gpd_bases(g)
    target = lambda k: remote.target_path(g, bases, k)
    with tempfile.TemporaryDirectory() as tmp:
        got = {}
        for m in cloud.download(g["appid"], tmp, [c["path"] for c in entry["cloud"]]):
            key = cloud_key(g, m["filename"])
            if key:
                target(key)   # validates
                got[key] = ((Path(tmp) / m["path"]).read_bytes(), m["mtime"])
        return len(remote.write_files(target, got, backup_dir(g["appid"])))


def push(entry, dt):
    """GPD -> desktop: every save file the GPD has. Returns number of files written."""
    g = entry["game"]
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tf:
        for lf in entry["local"]:
            if lf["exists"]:
                ti = tarfile.TarInfo(lf["key"])
                ti.size, ti.mtime = lf["size"], lf["mtime"]
                with open(lf["path"], "rb") as fh:
                    tf.addfile(ti, io.BytesIO(fh.read()))
    return len(dt.put(g["appid"], buf.getvalue()))


# ----- UI -----
KEYS = ("↑↓ select   c pull cloud→GPD   g pull desktop→GPD   p push GPD→desktop   "
        "Enter copy newest→GPD   r refresh   q quit")


class UI:
    def __init__(self, scr, cfg, dt, cloud):
        self.scr, self.cfg, self.dt, self.cloud = scr, cfg, dt, cloud
        self.pos = 0
        self.msg = ""
        self.entries, self.steam = [], False
        self.refresh()

    def refresh(self):
        def progress(name, done):
            self.entries = done
            self.say(f"Checking {name}...")
            self.draw()
        self.entries = load(self.cfg, self.dt, self.cloud, progress)
        self.steam = any(e["steam"] for e in self.entries)
        errs = {e["err"] for e in self.entries if e["err"]}
        errs |= {"Steam Cloud: " + e["cloud_err"] for e in self.entries if e["cloud_err"]}
        self.msg = "; ".join(sorted(errs))[:300]
        self.pos = min(self.pos, max(0, len(self.entries) - 1))

    def say(self, text):
        self.msg = text

    def add(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addnstr(y, x, text, w - x - 1, attr)
            except curses.error:
                pass

    def state_attr(self, s):
        return {SAME: curses.color_pair(1), NONE: curses.A_DIM, UNKNOWN: curses.A_DIM,
                MIXED: curses.color_pair(3)}.get(s, curses.color_pair(2))

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        host = self.cfg["desktop_host"].split("@")[-1]
        self.add(0, 1, f"Game saves   GPD ⇄ {host}, Steam Cloud → GPD", curses.A_BOLD)
        if self.steam:
            self.add(1, 1, "Steam is running on the desktop", curses.color_pair(2))
        cols = (1, 22, 40, 56, 74, 92)
        for x, t in zip(cols, ("Game", "vs desktop", "vs Steam Cloud", "GPD saved", "Desktop saved", "Cloud saved")):
            self.add(3, x, t, curses.A_UNDERLINE)
        for i, e in enumerate(self.entries):
            y = 4 + i
            sel = curses.A_REVERSE if i == self.pos else 0
            self.add(y, 0, " " * (w - 1), sel)
            self.add(y, cols[0], e["game"]["name"], sel)
            self.add(y, cols[1], text(e["state"], "desktop"), sel | self.state_attr(e["state"]))
            self.add(y, cols[2], text(e["cstate"], "cloud"), sel | self.state_attr(e["cstate"]))
            self.add(y, cols[3], when(newest(e["local"])), sel)
            self.add(y, cols[4], when(newest(e["remote"])), sel)
            self.add(y, cols[5], when(newest(e["cloud"])), sel)
        if self.pos < len(self.entries):   # during a refresh the list is still filling up
            self.detail(5 + len(self.entries))
        self.add(h - 2, 1, self.msg, curses.A_BOLD)
        self.add(h - 1, 1, KEYS, curses.A_DIM)
        scr.refresh()

    def detail(self, y):
        e = self.entries[self.pos]
        self.add(y, 1, e["game"]["name"], curses.A_BOLD)
        if e["err"]:
            self.add(y, 3 + len(e["game"]["name"]), e["err"], curses.color_pair(3))
        self.add(y + 1, 3, f"{'file':<26}{'vs desktop':<16}{'vs cloud':<15}{'GPD':<18}{'desktop':<18}{'cloud':<18}",
                 curses.A_UNDERLINE)
        h = self.scr.getmaxyx()[0]
        room = max(1, h - y - 6)
        rows = e["rows"]
        if len(rows) > room:
            self.add(y + 2 + room, 3, f"... {len(rows) - room} more file(s)")
        for j, r in enumerate(rows[:room]):
            t = lambda f: when(f["mtime"]) if f else "-"
            self.add(y + 2 + j, 3, f"{r['name'][-25:]:<26}", 0)
            self.add(y + 2 + j, 29, f"{text(r['dcode'], 'desktop'):<16}", self.state_attr(r["dcode"]))
            self.add(y + 2 + j, 45, f"{text(r['ccode'], 'cloud'):<15}", self.state_attr(r["ccode"]))
            self.add(y + 2 + j, 60, f"{t(r['gpd']):<18}{t(r['desk']):<18}{t(r['cloud']):<18}", 0)
        if not rows:
            self.add(y + 2, 3, "no save files anywhere")
        if e["game"].get("unverified_desktop"):
            self.add(y + 4 + min(len(rows), room), 3,
                     "Desktop paths for this game are unverified guesses: don't push until they are checked.",
                     curses.color_pair(2))
        if e["desk_cloud"] == "needs Steam launch":
            self.add(y + 3 + min(len(rows), room), 3,
                     "Steam Cloud has not received the desktop's files yet: start the game once in Steam there.",
                     curses.color_pair(2))

    def confirm(self, text_):
        self.say(text_ + "  [y/N]")
        self.draw()
        k = self.scr.getch()
        self.say("")
        return k in (ord("y"), ord("Y"))

    def copy(self, source):
        """source: "cloud" (cloud -> GPD), "desktop" (desktop -> GPD) or "push" (GPD -> desktop)."""
        e = self.entries[self.pos]
        name = e["game"]["name"]
        if source == "cloud":
            if e["cloud"] is None:
                self.say(f"{name}: Steam Cloud not available ({e['cloud_err'] or 'game not mapped'}).")
                return
            files, st, src, dst, other = e["cloud"], e["cstate"], "Steam Cloud", "GPD", "cloud"
        elif source == "desktop":
            if e["err"]:
                self.say(f"{name}: {e['err']}")
                return
            files, st, src, dst, other = e["remote"] or [], e["state"], "desktop", "GPD", "desktop"
        else:
            if e["err"]:
                self.say(f"{name}: {e['err']}")
                return
            files, st, src, dst, other = e["local"], e["state"], "GPD", "desktop", "desktop"
        if not [f for f in files if f.get("exists")]:
            self.say(f"Nothing to copy: {src} has no saves for {name}.")
            return
        if st == SAME:
            self.say(f"{name} is already in sync.")
            return
        warn = ""
        if source == "push" and st == OTHER_NEWER:
            warn = " WARNING: the desktop is newer!"
        elif source != "push" and st == GPD_NEWER:
            warn = " WARNING: the GPD is newer!"
        elif st == MIXED:
            warn = " Files differ in both directions."
        if source == "push" and self.steam:
            warn += " Steam is running."
        if source != "cloud" and e["game"].get("unverified_desktop"):
            warn += " Desktop paths unverified!"
        if not self.confirm(f"Copy {name} {src} → {dst}?{warn}"):
            self.say("Cancelled.")
            return
        self.say("Copying...")
        self.draw()
        try:
            n = {"cloud": lambda: pull_cloud(e, self.cloud), "desktop": lambda: pull(e, self.dt),
                 "push": lambda: push(e, self.dt)}[source]()
        except (RuntimeError, ValueError, tarfile.TarError, OSError) as ex:
            self.say(f"Copy failed: {ex}")
            return
        self.refresh()
        extra = "  Start the game once in Steam on the desktop to upload to Steam Cloud." if source == "push" else ""
        self.msg = f"Copied {n} file(s) {src} → {dst} (old copies backed up).{extra}"

    def best_source(self, e):
        """Where Enter pulls from: the cloud if it is newer/only there, else the desktop if so."""
        if e["cloud"] is not None and e["cstate"] in (OTHER_NEWER, ONLY_OTHER):
            return "cloud"
        if not e["err"] and e["state"] in (OTHER_NEWER, ONLY_OTHER):
            return "desktop"
        if not e["err"] and e["state"] in (GPD_NEWER, ONLY_GPD):
            return "push"
        return None

    def run(self):
        while True:
            self.draw()
            k = self.scr.getch()
            n = len(self.entries)
            if k in (ord("q"), 27):
                return
            elif k in (curses.KEY_UP, ord("k")) and n:
                self.pos = (self.pos - 1) % n
            elif k in (curses.KEY_DOWN, ord("j")) and n:
                self.pos = (self.pos + 1) % n
            elif k == ord("r"):
                self.refresh()
            elif k == ord("c") and n:
                self.copy("cloud")
            elif k == ord("g") and n:
                self.copy("desktop")
            elif k == ord("p") and n:
                self.copy("push")
            elif k in (10, 13, curses.KEY_ENTER) and n:
                src = self.best_source(self.entries[self.pos])
                if src:
                    self.copy(src)
                else:
                    self.say("Nothing newer to copy (or unclear): use c, g or p.")


def tui(scr, cfg):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    curses.init_pair(3, curses.COLOR_RED, -1)
    UI(scr, cfg, Desktop(cfg["desktop_host"]), Cloud()).run()


def main():
    cfg = json.loads((REPO / "games/saves.json").read_text())
    if "--list" in sys.argv:
        for e in load(cfg, Desktop(cfg["desktop_host"]), Cloud()):
            for msg in (e["err"], e["cloud_err"] and "Steam Cloud: " + e["cloud_err"]):
                if msg:
                    print(f"{e['game']['name']}: {msg}")
            print(f"{e['game']['name']:<22}desktop: {text(e['state'], 'desktop'):<18}cloud: {text(e['cstate'], 'cloud'):<16}"
                  f"GPD {when(newest(e['local']))}  desktop {when(newest(e['remote']))}  cloud {when(newest(e['cloud']))}")
            for r in e["rows"]:
                print(f"    {r['name']:<40}{text(r['dcode'], 'desktop'):<18}{text(r['ccode'], 'cloud')}")
        return 0
    import locale
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(tui, cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
