#!/usr/bin/env python3
"""Game saves: compare this GPD's saves with the desktop's and copy either way, per game.

Full-screen curses UI (Pegasus: Utilities > Game Saves). Reads games/saves.json; the desktop's
side comes over ssh from desktop/save-status-remote (restricted key: it can only run that script,
which only touches the paths in saves.json and backs up what it overwrites). Local files are
backed up to ~/save-backups/<time>/<appid>/ before they are overwritten.

  save-status            the UI
  save-status --list     print the table and exit
"""
import curses, importlib.machinery, importlib.util, io, json, os, subprocess, sys, tarfile, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# Reuse the desktop script's tar validation and file writing (same format both ways).
_loader = importlib.machinery.SourceFileLoader("saveremote", str(REPO / "desktop/save-status-remote"))
_spec = importlib.util.spec_from_loader("saveremote", _loader)
remote = importlib.util.module_from_spec(_spec)
_loader.exec_module(remote)

SAME, GPD_NEWER, DESK_NEWER, ONLY_GPD, ONLY_DESK, MIXED, NONE, UNKNOWN = (
    "in sync", "GPD newer", "desktop newer", "only on GPD", "only on desktop", "differ", "no saves",
    "no desktop info")
CLOUD = {"synced": "in sync", "needs-launch": "needs Steam launch", "no-cloud": "no cloud data", None: ""}
SSH = ["ssh", "-4", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5"]


def when(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if ts else "-"


# ----- desktop transport -----
class Desktop:
    def __init__(self, host):
        self.host = host

    def _run(self, cmd, data=None):
        try:
            r = subprocess.run(SSH + [self.host, cmd], input=data, capture_output=True, timeout=120)
        except subprocess.TimeoutExpired:
            raise RuntimeError("desktop timed out")
        if r.returncode != 0:
            err = r.stderr.decode(errors="replace").strip().splitlines()
            msg = err[-1] if err else "ssh failed"
            raise RuntimeError(self.OLD if msg.startswith("usage:") else msg)
        return r.stdout

    def status(self, appid):
        """One game's desktop state (dict with "files", "cloud"; or "unknown": true), steam_running."""
        d = json.loads(self._run(f"status {appid}"))
        games = [g for g in d["games"] if g["appid"] == appid]
        if len(games) != 1 or any("key" not in f for f in games[0].get("files", [])):
            raise RuntimeError(self.OLD)
        return games[0], d.get("steam_running", False)

    OLD = "the desktop's save-status-remote is out of date: git pull in ~/Code/gpdwin there"

    def get(self, appid):
        data = self._run(f"get {appid}")
        if data.startswith(b'{"games"'):   # old script ignores the command and prints status
            raise RuntimeError(self.OLD)
        return data

    def put(self, appid, data):
        try:
            return json.loads(self._run(f"put {appid}", data))["written"]
        except (KeyError, ValueError):
            raise RuntimeError(self.OLD)


# ----- save data -----
def gpd_bases(game):
    return [Path(os.path.expanduser(f["gpd"])) for f in game["files"]]


def local_files(game):
    return remote.scan(game, gpd_bases(game))


def label(e):
    """Name to show for a scanned file: the path inside its folder, or the file name."""
    return e["key"].split("/", 1)[1] if "/" in e["key"] else Path(e["path"]).name


def classify(local, rem):
    """-> (state, per-file rows [(name, state, gpd file, desktop file)], problem files first)."""
    lmap = {e["key"]: e for e in local if e["exists"]}
    rmap = {e["key"]: e for e in (rem or []) if e["exists"]}
    rows, kinds = [], set()
    for key in sorted(lmap.keys() | rmap.keys()):
        lf, rf = lmap.get(key), rmap.get(key)
        if rf is None:
            k = ONLY_GPD
        elif lf is None:
            k = ONLY_DESK
        elif lf["sha"] == rf["sha"]:
            k = SAME
        elif lf["mtime"] > rf["mtime"]:
            k = GPD_NEWER
        elif lf["mtime"] < rf["mtime"]:
            k = DESK_NEWER
        else:
            k = MIXED
        rows.append((label(lf or rf), k, lf or {"exists": False}, rf or {"exists": False}))
        kinds.add(k)
    rows.sort(key=lambda r: r[1] == SAME)
    if rem is None:
        return UNKNOWN, rows
    if not kinds:
        return NONE, rows
    if kinds == {SAME}:
        return SAME, rows
    kinds.discard(SAME)
    return (kinds.pop() if len(kinds) == 1 else MIXED), rows


def newest(files):
    return max((f["mtime"] for f in files if f.get("exists")), default=0)


def scan_game(g, dt, fail=None):
    """One game's entry. `fail` (an earlier connection error) skips asking the desktop again.
    The entry has "err" set when the desktop side is unknown (unreachable, old script, or the
    desktop's saves.json doesn't list the game)."""
    local = local_files(g)
    rem, steam, err = None, None, fail
    if not fail:
        try:
            r, steam = dt.status(g["appid"])
            if r.get("unknown"):
                err = "the desktop doesn't know this game: git pull in ~/Code/gpdwin there"
            else:
                rem = r
        except (RuntimeError, ValueError, KeyError, OSError) as e:
            err = str(e)
    state, rows = classify(local, rem["files"] if rem else None)
    return {"game": g, "local": local, "remote": rem["files"] if rem else None, "state": state,
            "rows": rows, "cloud": CLOUD.get(rem.get("cloud"), "") if rem else "", "err": err,
            "steam": steam, "conn_failed": bool(err and not (rem or "doesn't know" in err))}


def load(cfg, dt, progress=None):
    """Scan every game (asking the desktop about each one separately) -> entries."""
    entries, fail = [], None
    for g in cfg["games"]:
        if progress:
            progress(g["name"], entries)
        e = scan_game(g, dt, fail)
        if e["conn_failed"]:
            fail = e["err"]
        entries.append(e)
    return entries


def backup_dir(appid):
    return Path.home() / "save-backups" / time.strftime("%Y%m%d-%H%M%S") / appid


def pull(entry, dt):
    """Desktop -> GPD: every save file the desktop has. Returns number of files written."""
    g = entry["game"]
    bases = gpd_bases(g)
    target = lambda k: remote.target_path(g, bases, k)
    got = remote.read_members(io.BytesIO(dt.get(g["appid"])), target)
    return len(remote.write_files(target, got, backup_dir(g["appid"])))


def push(entry, dt):
    """GPD -> desktop: every save file the GPD has. Returns number of files written."""
    g = entry["game"]
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tf:
        for lf in entry["local"]:
            if lf["exists"]:
                ti = tarfile.TarInfo(lf["key"])
                ti.size, ti.mtime = lf["size"], lf["mtime"]
                with open(lf["path"], "rb") as fh:
                    tf.addfile(ti, io.BytesIO(fh.read()))
    return len(dt.put(g["appid"], buf.getvalue()))


# ----- UI -----
KEYS = ("↑↓ select   p push GPD→desktop   g pull desktop→GPD   Enter copy newer→older   "
        "r refresh   q quit")


class UI:
    def __init__(self, scr, cfg, dt):
        self.scr, self.cfg, self.dt = scr, cfg, dt
        self.pos = 0
        self.msg = ""
        self.entries, self.steam = [], False
        self.refresh()

    def refresh(self):
        def progress(name, done):
            self.entries = done
            self.say(f"Checking desktop: {name}...")
            self.draw()
        self.entries = load(self.cfg, self.dt, progress)
        self.steam = any(e["steam"] for e in self.entries)
        errs = {e["err"] for e in self.entries if e["err"]}
        self.msg = "; ".join(sorted(errs))[:200]
        self.pos = min(self.pos, max(0, len(self.entries) - 1))

    def say(self, text):
        self.msg = text

    def add(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addnstr(y, x, text, w - x - 1, attr)
            except curses.error:
                pass

    def state_attr(self, s):
        return {SAME: curses.color_pair(1), NONE: curses.A_DIM, UNKNOWN: curses.A_DIM,
                MIXED: curses.color_pair(3)}.get(s, curses.color_pair(2))

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        host = self.cfg["desktop_host"].split("@")[-1]
        self.add(0, 1, f"Game saves   GPD ⇄ {host}", curses.A_BOLD)
        if self.steam:
            self.add(1, 1, "Steam is running on the desktop", curses.color_pair(2))
        cols = (1, 24, 42, 60, 78)
        for x, t in zip(cols, ("Game", "Status", "GPD saved", "Desktop saved", "Steam Cloud")):
            self.add(3, x, t, curses.A_UNDERLINE)
        for i, e in enumerate(self.entries):
            y = 4 + i
            sel = curses.A_REVERSE if i == self.pos else 0
            self.add(y, 0, " " * (w - 1), sel)
            self.add(y, cols[0], e["game"]["name"], sel)
            self.add(y, cols[1], e["state"], sel | self.state_attr(e["state"]))
            self.add(y, cols[2], when(newest(e["local"])), sel)
            self.add(y, cols[3], when(newest(e["remote"] or [])), sel)
            self.add(y, cols[4], e["cloud"], sel)
        if self.entries:
            self.detail(5 + len(self.entries))
        self.add(h - 2, 1, self.msg, curses.A_BOLD)
        self.add(h - 1, 1, KEYS, curses.A_DIM)
        scr.refresh()

    def detail(self, y):
        e = self.entries[self.pos]
        self.add(y, 1, e["game"]["name"], curses.A_BOLD)
        if e["err"]:
            self.add(y, 3 + len(e["game"]["name"]), e["err"], curses.color_pair(3))
        self.add(y + 1, 3, f"{'file':<28}{'status':<18}{'GPD':<20}{'desktop':<20}", curses.A_UNDERLINE)
        h = self.scr.getmaxyx()[0]
        room = max(1, h - y - 6)
        shown = e["rows"][:room]
        if len(e["rows"]) > room:
            self.add(y + 2 + room, 3, f"... {len(e['rows']) - room} more file(s) (all in sync)"
                     if all(r[1] == SAME for r in e["rows"][room:]) else
                     f"... {len(e['rows']) - room} more file(s)")
        for j, (name, k, lf, rf) in enumerate(shown):
            gt = f"{when(lf['mtime'])}" if lf["exists"] else "-"
            dt_ = f"{when(rf['mtime'])}" if rf.get("exists") else "-"
            self.add(y + 2 + j, 3, f"{name[-27:]:<28}", 0)
            self.add(y + 2 + j, 31, f"{k:<18}", self.state_attr(k))
            self.add(y + 2 + j, 49, f"{gt:<20}{dt_:<20}", 0)
        if not e["rows"]:
            self.add(y + 2, 3, "no save files on either side")
        if e["cloud"] == "needs Steam launch":
            self.add(y + 3 + min(len(e["rows"]), room), 3,
                     "Steam Cloud has not uploaded the desktop's files yet: start the game once in Steam.",
                     curses.color_pair(2))

    def confirm(self, text):
        self.say(text + "  [y/N]")
        self.draw()
        k = self.scr.getch()
        self.say("")
        return k in (ord("y"), ord("Y"))

    def copy(self, direction):
        e = self.entries[self.pos]
        name = e["game"]["name"]
        if e["err"]:
            self.say(f"{name}: {e['err']}")
            return
        has = [f for f in (e["local"] if direction == "push" else e["remote"] or []) if f.get("exists")]
        if not has:
            self.say(f"Nothing to copy: {'GPD' if direction == 'push' else 'desktop'} has no saves for {name}.")
            return
        st = e["state"]
        if st == SAME:
            self.say(f"{name} is already in sync.")
            return
        src, dst = ("GPD", "desktop") if direction == "push" else ("desktop", "GPD")
        warn = ""
        if (direction == "push" and st == DESK_NEWER) or (direction == "pull" and st == GPD_NEWER):
            warn = f" WARNING: {dst} is newer!"
        elif st == MIXED:
            warn = " Files differ in both directions."
        if direction == "push" and self.steam:
            warn += " Steam is running."
        if not self.confirm(f"Copy {name} {src} → {dst}?{warn}"):
            self.say("Cancelled.")
            return
        self.say("Copying...")
        self.draw()
        try:
            n = (push if direction == "push" else pull)(e, self.dt)
        except (RuntimeError, ValueError, tarfile.TarError, OSError) as ex:
            self.say(f"Copy failed: {ex}")
            return
        self.refresh()
        extra = "  Start the game once in Steam to upload to Steam Cloud." if direction == "push" else ""
        self.msg = f"Copied {n} file(s) {src} → {dst} (old copies backed up).{extra}"

    def run(self):
        while True:
            self.draw()
            k = self.scr.getch()
            n = len(self.entries)
            if k in (ord("q"), 27):
                return
            elif k in (curses.KEY_UP, ord("k")) and n:
                self.pos = (self.pos - 1) % n
            elif k in (curses.KEY_DOWN, ord("j")) and n:
                self.pos = (self.pos + 1) % n
            elif k == ord("r"):
                self.refresh()
            elif k == ord("p"):
                self.copy("push")
            elif k == ord("g"):
                self.copy("pull")
            elif k in (10, 13, curses.KEY_ENTER) and n:
                st = self.entries[self.pos]["state"]
                if st in (GPD_NEWER, ONLY_GPD):
                    self.copy("push")
                elif st in (DESK_NEWER, ONLY_DESK):
                    self.copy("pull")
                else:
                    self.say("Not clear which side to copy: use p (push) or g (pull).")


def tui(scr, cfg):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_YELLOW, -1)
    curses.init_pair(3, curses.COLOR_RED, -1)
    UI(scr, cfg, Desktop(cfg["desktop_host"])).run()


def main():
    cfg = json.loads((REPO / "games/saves.json").read_text())
    if "--list" in sys.argv:
        for e in load(cfg, Desktop(cfg["desktop_host"])):
            if e["err"]:
                print(f"{e['game']['name']}: {e['err']}")
            print(f"{e['game']['name']:<22}{e['state']:<18}GPD {when(newest(e['local']))}  "
                  f"desktop {when(newest(e['remote'] or []))}  {e['cloud']}")
            for name, k, lf, rf in e["rows"]:
                print(f"    {name:<40}{k}")
        return 0
    import locale
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(tui, cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
