#!/usr/bin/env python3
"""Tune the speaker compressor live while a game plays (Super+C; docs/hardware.md, "Speaker loudness").

The game keeps keyboard focus (RetroArch pauses when it loses it): sway's "speaker-tune" mode
(dotfiles/sway/config) catches the keys and runs `speaker-tune key K`; a small foot window that
never takes focus runs `speaker-tune view` and shows the values. State lives in
$XDG_RUNTIME_DIR/speaker-tune.json while tuning.

  speaker-tune start        unfullscreen the game (tabbed layout), open the view, enter the mode
  speaker-tune stop         close the view, leave the mode, restore layout and fullscreen
  speaker-tune key K        K: up down left right bypass save revert
  speaker-tune view         the display loop (run by start)

Changes apply at once (pw-cli on the filter node); `save` writes them into
dotfiles/pipewire/pipewire.conf.d/30-speaker-compressor.conf (commit it afterwards), `revert`
reloads the saved values. Bypass compares with the unprocessed sound without losing the values.
"""
import fcntl, json, os, re, subprocess, sys, textwrap, time
from pathlib import Path

NODE = "speaker_compressor"
CONF = Path(__file__).resolve().parent.parent / "dotfiles/pipewire/pipewire.conf.d/30-speaker-compressor.conf"
WIDTH, HEIGHT = 50, 23    # view window, in characters
STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "speaker-tune.json"

# label, filter params (same value), config key in CONF, step, min, max, format
PARAMS = [
    ("Bass cut (Hz)",   ["hpL:Freq", "hpR:Freq"],           '"Freq"',                 25, 20, 600, "{:.0f}"),
    ("Threshold (dB)",  ["comp:Threshold level (dB)"],      '"Threshold level (dB)"',  2, -40, 0, "{:.0f}"),
    ("Ratio (1:n)",     ["comp:Ratio (1:n)"],               '"Ratio (1:n)"',         0.5, 1, 10, "{:.1f}"),
    ("Makeup gain (dB)", ["comp:Makeup gain (dB)"],         '"Makeup gain (dB)"',      1, 0, 18, "{:.0f}"),
    ("Ceiling (dB)",    ["lim:Limit (dB)"],                 '"Limit (dB)"',            1, -30, 0, "{:.0f}"),
    ("Attack (ms)",     ["comp:Attack time (ms)"],          '"Attack time (ms)"',      5, 1.5, 100, "{:.0f}"),
    ("Release (ms)",    ["comp:Release time (ms)"],         '"Release time (ms)"',    50, 50, 1500, "{:.0f}"),
]
# shown under the list for the selected setting: what it does and what to expect
HELP = [
    "Removes bass below this frequency. The tiny speakers can't play it; it only rattles them and "
    "uses up loudness. Higher: cleaner and louder, but thinner. Lower: fuller, more distortion.",
    "Level where compression starts. Sounds louder than this are turned down. Lower: more of the "
    "sound is compressed (more even, can sound flat). Higher: only the loudest parts are touched.",
    "How hard sound above the threshold is turned down: 3 means 3 dB louder in, 1 dB out. 1 = off. "
    "Higher: more even and dense, can pump or sound squashed.",
    "Raises everything after compression: this is what makes it louder, quiet parts most. Higher: "
    "louder, but more hiss and distortion at high volume. 0: no extra loudness.",
    "Hard cap on the output level (0 = full scale). Lower it if loud parts distort at max volume. "
    "Too low: everything gets squashed against it and loses punch.",
    "How fast compression reacts to a loud sound. Shorter: catches sudden peaks, but can dull or "
    "crackle them. Longer: punchier hits, peaks slip through to the ceiling.",
    "How fast it lets go after a loud sound. Shorter: livelier but can 'pump' (level wobbles). "
    "Longer: smoother, but quiet sounds right after loud ones stay quiet a moment.",
]
# bypass: no bass cut, no compression, no makeup, limiter at full scale
BYPASS = {"hpL:Freq": 10.0, "hpR:Freq": 10.0, "comp:Ratio (1:n)": 1.0, "comp:Makeup gain (dB)": 0.0, "lim:Limit (dB)": 0.0}


def live_values():
    out = subprocess.run(["pw-cli", "e", NODE, "Props"], capture_output=True, text=True).stdout
    vals = dict(re.findall(r'String "([^"]+)"\s+Float ([-\d.]+)', out))
    return [float(vals[p[1][0]]) for p in PARAMS]


def saved_values():
    text = CONF.read_text()
    return [float(re.search(re.escape(p[2]) + r"\s*=\s*([-\d.]+)", text).group(1)) for p in PARAMS]


def load():
    try:
        return json.loads(STATE.read_text())
    except (FileNotFoundError, ValueError):
        return {"sel": 0, "bypass": False, "values": live_values(), "msg": ""}


def store(st):
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st))
    tmp.replace(STATE)


def apply(st):
    if st["bypass"]:
        pairs = list(BYPASS.items())
    else:
        pairs = [(name, v) for p, v in zip(PARAMS, st["values"]) for name in p[1]]
    body = " ".join(f'"{k}" {float(v)}' for k, v in pairs)
    subprocess.run(["pw-cli", "s", NODE, "Props", "{ params = [ " + body + " ] }"], capture_output=True)


def save(values):
    text = CONF.read_text()
    for p, v in zip(PARAMS, values):
        text = re.sub(re.escape(p[2]) + r"(\s*=\s*)[-\d.]+", lambda m: p[2] + m.group(1) + f"{float(v):.1f}", text)
    CONF.write_text(text)


def key(k):
    # held keys repeat faster than a step runs: serialize the read-modify-write of the state
    lock = open(STATE.with_suffix(".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    st = load()
    n = len(PARAMS)
    if k == "up":
        st["sel"] = (st["sel"] - 1) % n
    elif k == "down":
        st["sel"] = (st["sel"] + 1) % n
    elif k in ("left", "right"):
        _, _, _, step, lo, hi, _ = PARAMS[st["sel"]]
        v = st["values"][st["sel"]] + (step if k == "right" else -step)
        st["values"][st["sel"]] = round(min(hi, max(lo, v)), 2)
        st["bypass"] = False
        st["msg"] = ""
        apply(st)
    elif k == "bypass":
        st["bypass"] = not st["bypass"]
        apply(st)
    elif k == "save":
        save(st["values"])
        st["msg"] = "saved to the config (commit it in ~/gpd)"
    elif k == "revert":
        st["values"], st["bypass"] = saved_values(), False
        st["msg"] = "reverted to the saved values"
        apply(st)
    store(st)


def view():
    sys.stdout.write("\033[?25l")
    while True:
        st = load()
        lines = ["Speaker compressor" + ("   [BYPASS: unprocessed]" if st["bypass"] else ""), ""]
        for i, (p, v) in enumerate(zip(PARAMS, st["values"])):
            mark = ">" if i == st["sel"] else " "
            lines.append(f" {mark} {p[0]:<17} {p[6].format(v):>6}")
        lines.append("")
        lines += [" " + l for l in textwrap.wrap(HELP[st["sel"]], WIDTH - 2)]
        lines += ["", " up/down select   left/right change", " b bypass   s save   r revert   Esc done",
                  " volume keys work too", " " + st.get("msg", "")]
        sys.stdout.write("\033[H\033[2J" + "\n".join(lines))
        sys.stdout.flush()
        time.sleep(0.15)


def sway(*cmds):
    subprocess.run(["swaymsg", "; ".join(cmds)], capture_output=True)


def tree_find(pred):
    out = subprocess.run(["swaymsg", "-t", "get_tree"], capture_output=True, text=True).stdout
    stack = [json.loads(out)]
    while stack:
        n = stack.pop()
        if pred(n):
            return n
        stack += n.get("nodes", []) + n.get("floating_nodes", [])
    return None


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "start":
        game = tree_find(lambda n: n.get("focused") and n.get("type") == "con")
        gid = game["id"] if game else None
        st = {"sel": 0, "bypass": False, "values": live_values(), "msg": "", "game": gid}
        store(st)
        # Out of fullscreen so the floating value window can show above it. shelf shares the workspace
        # (tiled behind the game, and sway won't resize that split): tabbed layout gives the focused game
        # the whole workspace. fullscreen-stack.sh stands aside while STATE exists. sway ignores no_focus
        # for the new window, and games pause without focus (DevilutionX, RetroArch): hand it back.
        sway("fullscreen disable", "layout tabbed", 'mode "speaker-tune"',
             f"exec foot --app-id=speaker-tune -W {WIDTH}x{HEIGHT} {Path(__file__).resolve()} view")
        for _ in range(40):
            if tree_find(lambda n: n.get("app_id") == "speaker-tune"):
                break
            time.sleep(0.05)
        if gid:
            sway(f"[con_id={gid}] focus")
    elif cmd == "stop":
        st = load()
        if st["bypass"]:
            st["bypass"] = False
            apply(st)
        STATE.unlink(missing_ok=True)
        target = f"[con_id={st['game']}] " if st.get("game") else ""
        sway('[app_id="speaker-tune"] kill', 'mode "default"', target + "layout splith", target + "fullscreen enable")
    elif cmd == "key" and len(sys.argv) == 3:
        key(sys.argv[2])
    elif cmd == "view":
        view()
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
