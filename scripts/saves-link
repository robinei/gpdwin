#!/usr/bin/env python3
"""Keep every game's save data in ~/Saves/<game>/ and symlink it back to where the game looks for it.

Prefixes, install folders and ~/.local/share/<game> can then be deleted and recreated without losing saves
(docs/saves.md "Central save store"). The list of data folders per game is the "data" key of
games/saves.json (whole folders where possible: a game that saves by writing a temp file and renaming
it over the old one would silently turn a symlinked *file* into a normal file, and the status then shows
"conflict"). Settings that live in the same folder come along. For saves that sit among the game's own files
in its install folder an entry may be a single file or a pattern such as ".../Save*.dat" (a pattern only matches
files that are real files now, so run --apply again after the game made new ones).

  saves-link                       show the state of every game (changes nothing)
  saves-link --apply [GAME...]     fix what is not in place yet (all games, or those named: slug, name or app id)

States per data folder:
  ok        already a link into ~/Saves/<game>/<folder>
  migrate   a real folder: move it into ~/Saves/<game>/ and put the link in its place
  relink    nothing at the game's location (fresh install/prefix) but the store has it: create the link
  create    neither exists: create an empty store folder and the link (saves land there from the start)
  conflict  both a real folder with content and a store folder exist: nothing done, merge by hand
  other     the location is a link to somewhere else: nothing done

Nothing is touched while a process of the game (anything running from its install folder) is running.
<game> is the install folder's name under ~/Games/installed (the game with that Steam app id), else a
slug of the name.
"""
import glob, json, os, re, shutil, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOME = Path.home()
STORE = HOME / "Saves"
INSTALLED = HOME / "Games/installed"


def slug_of(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def installed_slugs():
    ids = {}
    for j in INSTALLED.glob("*/.gpd-game.json"):
        try:
            ids[str(json.loads(j.read_text())["id"])] = j.parent.name
        except (OSError, ValueError, KeyError):
            pass
    return ids


def targets(game, slug):
    """[(location, store_path)] for the game's "data" folders; names inside the store are the folder's last
    component, with the parent's name in front when two of the game's folders end the same."""
    paths = []
    for p in game.get("data", []):
        p = os.path.expanduser(p)
        if any(c in p for c in "*?["):       # a pattern for files that appear later (saves in an install folder)
            paths += [Path(m) for m in sorted(glob.glob(p)) if not os.path.islink(m)]
        else:
            paths.append(Path(p))
    names = [p.name for p in paths]
    out = []
    for p in paths:
        n = p.name if names.count(p.name) == 1 else f"{p.parent.name}-{p.name}"
        out.append((p, STORE / slug / n))
    return out


def tree_summary(p):
    """(files, bytes) below a folder (or for a file), not following links."""
    if p.is_file():
        return 1, p.stat().st_size
    n = size = 0
    for root, _dirs, files in os.walk(p):
        for f in files:
            fp = Path(root) / f
            n += 1
            try:
                size += fp.lstat().st_size
            except OSError:
                pass
    return n, size


def is_empty_dir(p):
    return p.is_dir() and not p.is_symlink() and not any(p.iterdir())


def state(loc, store):
    if loc.is_symlink():
        return "ok" if Path(os.path.realpath(loc)) == Path(os.path.realpath(store)) and store.exists() else "other"
    if not loc.exists():
        return "relink" if store.exists() else "create"
    if is_empty_dir(loc):
        return "relink" if store.exists() else "migrate"
    return "conflict" if store.exists() and not is_empty_dir(store) else "migrate"


def running(slug):
    """Process ids running from (cwd or command line inside) the game's install folder."""
    root = str(INSTALLED / slug)
    pids = []
    for d in Path("/proc").iterdir():
        if not d.name.isdigit() or int(d.name) == os.getpid():
            continue
        try:
            cwd = os.readlink(d / "cwd")
            cmd = (d / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if cwd.startswith(root) or root in cmd:
            pids.append(int(d.name))
    return pids


def move(loc, store):
    store.parent.mkdir(parents=True, exist_ok=True)
    if store.exists():                       # an empty store folder left from before
        store.rmdir()
    before = tree_summary(loc)
    try:
        os.rename(loc, store)                # same filesystem: atomic, nothing copied
    except OSError:
        shutil.copytree(loc, store, symlinks=True)
        if tree_summary(store) != before:
            shutil.rmtree(store)
            raise RuntimeError(f"copy of {loc} differs from the original, left in place")
        shutil.rmtree(loc)
    if tree_summary(store) != before:
        raise RuntimeError(f"{store} differs from what was at {loc} ({before} -> {tree_summary(store)})")


def link(loc, store):
    loc.parent.mkdir(parents=True, exist_ok=True)
    if loc.is_dir() and not loc.is_symlink():
        loc.rmdir()                          # an empty folder, e.g. one Wine created
    os.symlink(store, loc)
    if Path(os.path.realpath(loc)) != Path(os.path.realpath(store)):
        raise RuntimeError(f"link {loc} does not resolve to {store}")


def main():
    args = sys.argv[1:]
    apply = "--apply" in args
    wanted = [a for a in args if not a.startswith("--")]
    if "-h" in args or "--help" in args:
        print(__doc__)
        return 0
    cfg = json.loads((REPO / "games/saves.json").read_text())
    ids = installed_slugs()
    problems = 0
    shown = 0
    for g in cfg["games"]:
        if "data" not in g:
            continue
        slug = ids.get(str(g["appid"])) or slug_of(g["name"])
        if wanted and not ({slug, slug_of(g["name"]), g["name"], str(g["appid"])} & set(wanted)):
            continue
        shown += 1
        pids = running(slug) if apply else []
        for loc, store in targets(g, slug):
            st = state(loc, store)
            note = ""
            if apply and st in ("migrate", "relink", "create"):
                if pids:
                    st, note = "skipped", f"running (pid {pids[0]}...)"
                else:
                    try:
                        if st == "migrate":
                            move(loc, store)
                        elif st == "create":
                            store.mkdir(parents=True, exist_ok=True)
                        link(loc, store)
                        note = "done"
                    except (OSError, RuntimeError) as e:
                        st, note = "FAILED", str(e)
                        problems += 1
            elif st in ("conflict", "other"):
                problems += 1
            size = ""
            if st in ("migrate", "conflict") and loc.exists():
                n, b = tree_summary(loc)
                size = f"{n} files, {b / 1024:.0f} KB"
            print(f"{st:9} {slug:24} {str(loc).replace(str(HOME), '~'):58} -> {str(store).replace(str(HOME), '~')}"
                  + (f"   ({size})" if size else "") + (f"   {note}" if note else ""))
    if not shown:
        print("no game matches" if wanted else 'no game has a "data" list in games/saves.json')
        return 1
    if not apply:
        print("\n(nothing changed; --apply [GAME...] to do it)")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
