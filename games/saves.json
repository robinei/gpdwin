{
 "_doc": "Save files per game on the GPD and the desktop (see docs/saves.md). {steam} = desktop Steam root, {userdata} = desktop Steam userdata/<id>, {home} = desktop home. \"dir\": true = a folder: everything below it is synced file by file. Used by scripts/save-status (GPD) and desktop/save-status-remote.",
 "desktop_host": "robin@desktop.lan",
