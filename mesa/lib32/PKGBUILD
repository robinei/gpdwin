# GPD Win 1 lib32-mesa: Arch's lib32-mesa PKGBUILD 1:26.2.4-1 (PKGBUILD.arch, maintainers there) reduced like
# ../PKGBUILD (crocus + softpipe, hasvk; no LLVM, SPIRV-Tools, lm_sensors, video, OpenCL at runtime), for Wine's
# 32-bit games. Same package names as the installed Arch ones. See ../README.md.

pkgbase=lib32-mesa
pkgname=(
  lib32-mesa-gpd
  lib32-vulkan-intel-gpd
  lib32-vulkan-mesa-implicit-layers-gpd
)
pkgver=26.2.4
_pkgver=${pkgver/[a-z]/-&}
pkgrel=1.3
epoch=1
pkgdesc="Open-source OpenGL drivers - 32-bit (GPD Win 1 build: crocus + hasvk only)"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(
  lib32-expat
  lib32-gcc-libs
  lib32-glibc
  lib32-libdisplay-info
  lib32-libdrm
  lib32-libglvnd
  lib32-libx11
  lib32-libxcb
  lib32-libxext
  lib32-libxrandr
  lib32-libxshmfence
  lib32-libxxf86vm
  lib32-systemd
  lib32-vulkan-icd-loader
  lib32-wayland
  lib32-xcb-util-keysyms
  lib32-zlib
  lib32-zstd
  # build-time only, native (64-bit): mesa_clc/vtn_bindgen2 (stage 1 in build())
  clang
  libclc
  llvm
  spirv-llvm-translator
  spirv-tools
  meson
  python-mako
  python-packaging
  python-ply
  python-pycparser
  python-yaml
  wayland-protocols
  xorgproto
)
options=(
  # Arch: "In general, upstream considers LTO to be broken until explicit notice."
  !lto
)
source=(
  "https://archive.mesa3d.org/mesa-$_pkgver.tar.xz"{,.sig}
  0001-crocus-don-t-snoop-upload-staging-textures.patch
)
