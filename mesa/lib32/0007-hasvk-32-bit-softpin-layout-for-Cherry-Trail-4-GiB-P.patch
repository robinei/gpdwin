 }
 
+/* Choose the address layout.  In relocation mode (gfx7, HASVK_USE_RELOCATIONS)
+ * the kernel places the BOs and only the pool start offsets matter, which are
+ * those of the 48-bit layout as before.
+ */
+static void
+anv_physical_device_init_va(struct anv_physical_device *device)
+{
+   if (!device->use_softpin || device->supports_48bit_addresses) {
+      device->va = (struct anv_va_layout) {
+         .general_state_pool = ANV_VA_RANGE(GENERAL_STATE_POOL_MIN_ADDRESS,
+                                            GENERAL_STATE_POOL_MAX_ADDRESS),
+         .dynamic_state_pool = ANV_VA_RANGE(DYNAMIC_STATE_POOL_MIN_ADDRESS,
+                                            DYNAMIC_STATE_POOL_MAX_ADDRESS),
+         .binding_table_pool = ANV_VA_RANGE(BINDING_TABLE_POOL_MIN_ADDRESS,
+                                            BINDING_TABLE_POOL_MAX_ADDRESS),
+         .surface_state_pool = ANV_VA_RANGE(SURFACE_STATE_POOL_MIN_ADDRESS,
+                                            SURFACE_STATE_POOL_MAX_ADDRESS),
+         .instruction_state_pool =
+            ANV_VA_RANGE(INSTRUCTION_STATE_POOL_MIN_ADDRESS,
+                         INSTRUCTION_STATE_POOL_MAX_ADDRESS),
+         .client_visible_heap = ANV_VA_RANGE(CLIENT_VISIBLE_HEAP_MIN_ADDRESS,
+                                             CLIENT_VISIBLE_HEAP_MAX_ADDRESS),
+         .low_heap = ANV_VA_RANGE(LOW_HEAP_MIN_ADDRESS, LOW_HEAP_MAX_ADDRESS),
+         /* Leave the last 4GiB out of the high vma range, so that no state
+          * base address + size can overflow 48 bits. For more information see
+          * the comment about Wa32bitGeneralStateOffset in anv_allocator.c
+          */
+         .high_heap = {
+            .addr = HIGH_HEAP_MIN_ADDRESS,
+            .size = device->gtt_size - (1ull << 32) - HIGH_HEAP_MIN_ADDRESS,
+         },
+      };
+   } else {
+      /* 4 GiB PPGTT (Cherry Trail): see the layout comment in anv_private.h */
+      assert(device->gtt_size >= (4ULL << 30));
+      device->va = (struct anv_va_layout) {
+         .general_state_pool =
+            ANV_VA_RANGE(VA32_GENERAL_STATE_POOL_MIN_ADDRESS,
+                         VA32_GENERAL_STATE_POOL_MAX_ADDRESS),
+         .dynamic_state_pool =
+            ANV_VA_RANGE(VA32_DYNAMIC_STATE_POOL_MIN_ADDRESS,
+                         VA32_DYNAMIC_STATE_POOL_MAX_ADDRESS),
+         .binding_table_pool =
+            ANV_VA_RANGE(VA32_BINDING_TABLE_POOL_MIN_ADDRESS,
+                         VA32_BINDING_TABLE_POOL_MAX_ADDRESS),
+         .surface_state_pool =
+            ANV_VA_RANGE(VA32_SURFACE_STATE_POOL_MIN_ADDRESS,
+                         VA32_SURFACE_STATE_POOL_MAX_ADDRESS),
+         .instruction_state_pool =
+            ANV_VA_RANGE(VA32_INSTRUCTION_STATE_POOL_MIN_ADDRESS,
+                         VA32_INSTRUCTION_STATE_POOL_MAX_ADDRESS),
+         .client_visible_heap =
+            ANV_VA_RANGE(VA32_CLIENT_VISIBLE_HEAP_MIN_ADDRESS,
+                         VA32_CLIENT_VISIBLE_HEAP_MAX_ADDRESS),
+         .low_heap = ANV_VA_RANGE(VA32_LOW_HEAP_MIN_ADDRESS,
+                                  VA32_LOW_HEAP_MAX_ADDRESS),
+         .high_heap = { 0, 0 },
+      };
+   }
+}
