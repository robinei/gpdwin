diff --git a/src/intel/vulkan_hasvk/anv_allocator.c b/src/intel/vulkan_hasvk/anv_allocator.c
index a50abd2..ce15d43 100644
--- a/src/intel/vulkan_hasvk/anv_allocator.c
+++ b/src/intel/vulkan_hasvk/anv_allocator.c
@@ -368,7 +368,8 @@ anv_block_pool_init(struct anv_block_pool *pool,
                     struct anv_device *device,
                     const char *name,
                     uint64_t start_address,
-                    uint32_t initial_size)
+                    uint32_t initial_size,
+                    uint64_t max_size)
 {
    VkResult result;
 
@@ -377,6 +378,8 @@ anv_block_pool_init(struct anv_block_pool *pool,
    pool->use_relocations = anv_use_relocations(device->physical);
    pool->nbos = 0;
    pool->size = 0;
+   pool->max_size = max_size;
+   assert(max_size == 0 || initial_size <= max_size);
    pool->center_bo_offset = 0;
    pool->start_address = intel_canonical_address(start_address);
    pool->map = NULL;
@@ -679,6 +682,15 @@ anv_block_pool_grow(struct anv_block_pool *pool, struct anv_block_state *state,
    while (size < back_required + front_required)
       size *= 2;
 
+   /* With softpin the pool cannot grow past its address range. */
+   if (pool->max_size != 0 && size > pool->max_size) {
+      if (back_required + front_required > pool->max_size) {
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto done;
+      }
+      size = pool->max_size;
+   }
+
    assert(size > pool->size);
 
    /* We compute a new center_bo_offset such that, when we double the size
@@ -830,7 +842,8 @@ anv_state_pool_init(struct anv_state_pool *pool,
                     const char *name,
                     uint64_t base_address,
                     int32_t start_offset,
-                    uint32_t block_size)
+                    uint32_t block_size,
+                    uint64_t max_size)
 {
    /* We don't want to ever see signed overflow */
    assert(start_offset < INT32_MAX - (int32_t)BLOCK_POOL_MEMFD_SIZE);
@@ -839,7 +852,7 @@ anv_state_pool_init(struct anv_state_pool *pool,
 
    VkResult result = anv_block_pool_init(&pool->block_pool, device, name,
                                          base_address + start_offset,
-                                         initial_size);
+                                         initial_size, max_size);
    if (result != VK_SUCCESS)
       return result;
 
diff --git a/src/intel/vulkan_hasvk/anv_device.c b/src/intel/vulkan_hasvk/anv_device.c
index 5c2eab0..fcb2ef4 100644
--- a/src/intel/vulkan_hasvk/anv_device.c
