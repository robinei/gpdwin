diff --git a/src/intel/vulkan_hasvk/anv_private.h b/src/intel/vulkan_hasvk/anv_private.h
index 07996ca..26b98bb 100644
--- a/src/intel/vulkan_hasvk/anv_private.h
+++ b/src/intel/vulkan_hasvk/anv_private.h
@@ -177,6 +177,68 @@ struct intel_perf_query_result;
 #define CLIENT_VISIBLE_HEAP_SIZE               \
    (CLIENT_VISIBLE_HEAP_MAX_ADDRESS - CLIENT_VISIBLE_HEAP_MIN_ADDRESS + 1)
 
+/* 32-bit softpin layout
+ * =====================
+ *
+ * Cherry Trail (gfx8) has a full PPGTT of only 4 GiB (4 PDP entries, no
+ * EXEC_OBJECT_SUPPORTS_48B_ADDRESS), so the 48-bit layout above cannot be
+ * used.  The kernel accepts EXEC_OBJECT_PINNED at any page-aligned address
+ * below 4 GiB, so we squeeze the same pools into the low 1 GiB and give the
+ * rest to a single heap:
+ *
+ *   2 MiB .. 64 MiB   general state pool (base address 0, like above)
+ *  64 MiB .. 256 MiB  dynamic state pool
+ * 256 MiB .. 384 MiB  binding table pool (below the surface state pool
+ *                     within 4 GiB, see consideration (2) above)
+ * 384 MiB .. 640 MiB  surface state pool
+ * 640 MiB .. 768 MiB  instruction state pool
+ * 768 MiB .. 1 GiB    client visible heap (buffer device address
+ *                     capture/replay; dEQP's capture_replay_stress needs
+ *                     ~75-150 MiB of it)
+ *   1 GiB .. 4 GiB - 64 MiB  heap (the "low" heap; the high heap is empty)
+ *
+ * Consideration (1), the VF cache workaround, is trivially satisfied: every
+ * address is below 4 GiB.  Consideration (3) becomes a 64 MiB margin below
+ * the 4 GiB boundary.  The state pools cannot grow past their range
+ * (anv_block_pool::max_size).
+ */
+#define VA32_GENERAL_STATE_POOL_MIN_ADDRESS     0x00200000ULL /* 2 MiB */
+#define VA32_GENERAL_STATE_POOL_MAX_ADDRESS     0x03ffffffULL
+#define VA32_DYNAMIC_STATE_POOL_MIN_ADDRESS     0x04000000ULL /* 64 MiB */
+#define VA32_DYNAMIC_STATE_POOL_MAX_ADDRESS     0x0fffffffULL
+#define VA32_BINDING_TABLE_POOL_MIN_ADDRESS     0x10000000ULL /* 256 MiB */
+#define VA32_BINDING_TABLE_POOL_MAX_ADDRESS     0x17ffffffULL
+#define VA32_SURFACE_STATE_POOL_MIN_ADDRESS     0x18000000ULL /* 384 MiB */
+#define VA32_SURFACE_STATE_POOL_MAX_ADDRESS     0x27ffffffULL
+#define VA32_INSTRUCTION_STATE_POOL_MIN_ADDRESS 0x28000000ULL /* 640 MiB */
+#define VA32_INSTRUCTION_STATE_POOL_MAX_ADDRESS 0x2fffffffULL
+#define VA32_CLIENT_VISIBLE_HEAP_MIN_ADDRESS    0x30000000ULL /* 768 MiB */
+#define VA32_CLIENT_VISIBLE_HEAP_MAX_ADDRESS    0x3fffffffULL
+#define VA32_LOW_HEAP_MIN_ADDRESS               0x40000000ULL /* 1 GiB */
+#define VA32_LOW_HEAP_MAX_ADDRESS               0xfbffffffULL /* 4 GiB - 64 MiB - 1 */
+
+struct anv_va_range {
+   uint64_t addr;
+   uint64_t size;
+};
+
+#define ANV_VA_RANGE(min, max) \
+   ((struct anv_va_range) { .addr = (min), .size = (max) - (min) + 1 })
+
+/* The virtual address layout a softpin device uses (one of the two above),
+ * chosen in anv_physical_device_init_va().
+ */
+struct anv_va_layout {
+   struct anv_va_range general_state_pool;
+   struct anv_va_range dynamic_state_pool;
+   struct anv_va_range binding_table_pool;
+   struct anv_va_range surface_state_pool;
+   struct anv_va_range instruction_state_pool;
+   struct anv_va_range client_visible_heap;
+   struct anv_va_range low_heap;
+   struct anv_va_range high_heap;  /* size 0 in the 32-bit layout */
+};
+
 /* Allowing different clear colors requires us to perform a depth resolve at
  * the end of certain render passes. This is because while slow clears store
  * the clear color in the HiZ buffer, fast clears (without a resolve) don't.
@@ -566,6 +628,11 @@ struct anv_block_pool {
 
    uint64_t size;
 
+   /* The pool never grows past this size (0: no limit other than the memfd
+    * size).  With softpin this is the size of the pool's address range.
+    */
+   uint64_t max_size;
+
    /* The address where the start of the pool is pinned. The various bos that
