       }
 
+      const struct anv_va_layout *va = &physical_device->va;
+
       /* keep the page with address zero out of the allocator */
       util_vma_heap_init(&device->vma_lo,
-                         LOW_HEAP_MIN_ADDRESS, LOW_HEAP_SIZE);
+                         va->low_heap.addr, va->low_heap.size);
 
