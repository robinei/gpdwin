prepare() {
  cd mesa-$_pkgver

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  echo "$_pkgver-arch$epoch.$pkgrel" >VERSION
}

build() {
  # Stage 1: the build-time compilers crocus/hasvk need (their OpenCL C kernels are compiled to NIR at build
  # time). They need LLVM; built here for the build host only, so the installed libraries do not link LLVM.
  # (plain meson setup: arch-meson's --auto-features=enabled would pull in everything)
  meson setup build-clc mesa-$_pkgver --buildtype=plain --wrap-mode=nofallback \
    -D mesa-clc=enabled -D install-mesa-clc=true -D llvm=enabled -D gallium-drivers= -D vulkan-drivers= -D vulkan-layers= \
    -D platforms= -D egl=disabled -D gbm=disabled -D glx=disabled -D glvnd=disabled
  meson compile -C build-clc mesa_clc vtn_bindgen2
  export PATH="$srcdir/build-clc/src/compiler/clc:$srcdir/build-clc/src/compiler/spirv:$PATH"

  # Stage 2: the drivers, for the target
  CFLAGS="${CFLAGS/-march=x86-64 -mtune=generic/-march=$_march -mtune=$_mtune}"
  CXXFLAGS="${CXXFLAGS/-march=x86-64 -mtune=generic/-march=$_march -mtune=$_mtune}"
  echo "CFLAGS=$CFLAGS"

  # shellcheck disable=SC2054
  local meson_options=(
    --optimization 2
    -D android-libbacktrace=disabled
    -D b_ndebug=true
    -D platforms=x11,wayland
    -D gallium-drivers=crocus,softpipe
    -D vulkan-drivers=intel_hasvk
    -D vulkan-layers=device-select,anti-lag
    -D gallium-extra-hud=false
    -D gallium-va=disabled
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl=false
    -D video-codecs=
    -D mesa-clc=system
    -D llvm=disabled
    -D spirv-tools=disabled
    -D lmsensors=disabled
    -D libunwind=disabled
    -D valgrind=disabled
    -D html-docs=disabled
    -D intel-rt=disabled
    -D microsoft-clc=disabled
    -D gles1=disabled
    -D vulkan-loader-rpath=
    -D vulkan-manifest-per-architecture=false
  )

  arch-meson mesa-$_pkgver build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_mesa-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of mesa do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  depends=(
    expat
    glibc
    libdrm
    libgcc
    libglvnd
    libstdc++
    libx11
    libxcb
    libxext
    libxshmfence
    libxxf86vm
    wayland
    zlib
    zstd
  )
  optdepends=("opengl-man-pages: for the OpenGL API man pages")
  provides=(
    "mesa=$epoch:$pkgver-$pkgrel"
    "mesa-libgl=$epoch:$pkgver-$pkgrel"
    opengl-driver
  )
  conflicts=(mesa 'mesa-libgl<17.0.1-2')
  replaces=('mesa-libgl<17.0.1-2')

  meson install -C build --destdir "$pkgdir" --no-rebuild

  (
    local libdir=usr/lib

    cd "$pkgdir"

    _pick vkintel $libdir/libvulkan_intel_hasvk.so
    _pick vkintel usr/share/vulkan/icd.d/intel_hasvk_icd.json

    _pick vkdevice $libdir/libVkLayer_MESA_anti_lag.so
    _pick vkdevice $libdir/libVkLayer_MESA_device_select.so
    _pick vkdevice usr/share/vulkan/implicit_layer.d

    # indirect rendering
    ln -sr $libdir/libGLX_{mesa,indirect}.so.0
  )

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-intel-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of vulkan-intel do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  pkgdesc="Open-source Vulkan driver for Intel GPUs (GPD Win 1 build: hasvk only)"
  depends=(
    expat
    glibc
    libdisplay-info
    libdrm
    libgcc
    libstdc++
    libx11
    libxcb
    libxshmfence
    systemd-libs
    vulkan-icd-loader
    vulkan-mesa-implicit-layers
    wayland
    xcb-util-keysyms
    zlib
    zstd
  )
  provides=("vulkan-intel=$epoch:$pkgver-$pkgrel" vulkan-driver)
  conflicts=(vulkan-intel)

  mv vkintel/* "$pkgdir"

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-mesa-implicit-layers-gpd() {
  # GPD rebuild under its own name (like mangohud-light): Arch updates of vulkan-mesa-implicit-layers do not replace it;
  # scripts/aur check reports when Arch has a newer version.
  pkgdesc="Mesa's implicit Vulkan layers"
  depends=(
    glibc
    libdrm
    libxcb
    wayland
  )
  provides=("vulkan-mesa-implicit-layers=$epoch:$pkgver-$pkgrel")
  conflicts=(vulkan-mesa-implicit-layers vulkan-mesa-device-select)
  replaces=(vulkan-mesa-device-select)

  mv vkdevice/* "$pkgdir"

  install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}
