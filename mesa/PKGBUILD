# GPD Win 1 Mesa: Arch's mesa PKGBUILD 1:26.2.4-1 (PKGBUILD.arch, maintainers there) reduced to what this device
# uses: Intel Gen8 (Cherry Trail) through crocus (OpenGL/GLES, EGL, GLX, GBM) and hasvk (Vulkan), softpipe as
# the software fallback; no LLVM, SPIRV-Tools, lm_sensors, video, OpenCL, docs or other drivers. Same package
# names and provides as Arch's for what is installed (mesa, vulkan-intel, vulkan-mesa-implicit-layers), plus our
# patches. See README.md. Diff against PKGBUILD.arch when Arch updates.

pkgbase=mesa
pkgname=(
  mesa-gpd
  vulkan-intel-gpd
  vulkan-mesa-implicit-layers-gpd
)
pkgver=26.2.4
_pkgver=${pkgver/[a-z]/-&}
pkgrel=1.3
epoch=1
pkgdesc="Open-source OpenGL drivers (GPD Win 1 build: crocus + hasvk only)"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
# CPU tuning for the one target (Atom x7-Z8700, Airmont = silvermont ISA: SSE4.2, no AVX). x86-64/generic = Arch's.
_march=x86-64
_mtune=generic
makedepends=(
  expat
  glibc
  libdisplay-info
  libdrm
  libgcc
  libglvnd
  libstdc++
  libx11
  libxcb
  libxext
  libxrandr
  libxshmfence
  libxxf86vm
  systemd-libs
  vulkan-icd-loader
  wayland
  xcb-util-keysyms
  zlib
  zstd
  # build-time only: mesa_clc/vtn_bindgen2 (stage 1 in build()), which compile the drivers' OpenCL C kernels
  clang
  libclc
  llvm
  spirv-llvm-translator
  spirv-tools
  meson
  python-mako
  python-packaging
  python-ply
  python-pycparser
  python-yaml
  wayland-protocols
  xorgproto
)
options=(
  # Arch: "In general, upstream considers LTO to be broken until explicit notice."
  !lto
)
source=(
  "https://archive.mesa3d.org/mesa-$_pkgver.tar.xz"{,.sig}
  0001-crocus-don-t-snoop-upload-staging-textures.patch
)
