#!/bin/sh
# Start Pegasus with its dbus-send shim first in PATH.
# QT_BEARER_POLL_TIMEOUT=-1: no Qt network bearer polling.
# MANGOHUD=1 + the shim preload: every game Pegasus starts gets MangoHud (Vulkan via the layer,
# OpenGL via the preload), hidden until Right Shift+F12; Pegasus itself is blacklisted in
# ~/.config/MangoHud/MangoHud.conf.
export MANGOHUD=1
# $LIB (literal, expanded by the dynamic linker) picks lib or lib32, so 32-bit games get lib32-mangohud.
[ -e /usr/lib/mangohud/libMangoHud_shim.so ] && export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}/usr/\$LIB/mangohud/libMangoHud_shim.so"
# stderr (Qt fatal errors, which don't reach lastrun.log) to ~/.cache/pegasus-fe.stderr, last 200 lines kept.
err="$HOME/.cache/pegasus-fe.stderr"
[ -f "$err" ] && tail -n 200 "$err" > "$err.tmp" && mv "$err.tmp" "$err"
# Which frontend: ~/.config/gpd/frontend says "shelf" (src/shelf.c, reads and writes the same files)
# or anything else/missing for Pegasus. Both share this environment and the crash restart.
fe=pegasus-fe
[ "$(cat "$HOME/.config/gpd/frontend" 2>/dev/null)" = shelf ] && fe="$HOME/.local/bin/shelf"
# Restarted when it crashes (SIGILL/TRAP/ABRT/BUS/FPE/SEGV; it sometimes aborts when the pad
# disconnects, docs/frontend.md), not when it quits or is killed (TERM/KILL, restart-pegasus).
# Gives up after 3 crashes within 10 s of starting.
export QT_BEARER_POLL_TIMEOUT=-1 PATH="$HOME/.config/pegasus-frontend/bin:$PATH"
quick=0
while :; do
    echo "--- start $fe $(date '+%F %T')" >> "$err"
    started=$(date +%s)
    "$fe" "$@" 2>> "$err"
    rc=$?
    case $rc in 132|133|134|135|136|139) ;; *) exit $rc ;; esac
    echo "--- crashed (exit $rc) $(date '+%F %T'), restarting" >> "$err"
    [ $(($(date +%s) - started)) -lt 10 ] && quick=$((quick + 1))
    [ $quick -ge 3 ] && exit $rc
    sleep 1
done
