# Dark theme (Catppuccin Mocha palette)
set $base     #1e1e2e
set $mantle   #181825
set $crust    #11111b
set $surface0 #313244
set $surface1 #45475a
set $surface2 #585b70
set $overlay  #7f849c
set $subtext  #a6adc8
set $text     #cdd6f4
set $blue     #89b4fa
set $pink     #f5c2e7
set $red      #f38ba8

# No background: sway (wlroots scene) leaves uncovered areas black, so no swaybg process runs.
# The old wallpaper: output * bg ~/.config/sway/wallpaper.jpg fill $crust
swaybg_command -

font pango:DejaVu Sans 10

# Thin borders, no title bars; no borders or gaps when a window is alone
default_border pixel 1
default_floating_border pixel 1
gaps inner 4
smart_gaps on
smart_borders on

# class                 border     bg       text      indicator  child_border
client.focused          $surface2  $base    $text     $surface2  $surface2
client.focused_inactive $surface0  $base    $subtext  $surface0  $surface0
client.unfocused        $mantle    $mantle  $overlay  $mantle    $mantle
client.urgent           $red       $base    $red      $red       $red

bar {
    position top
    font pango:DejaVu Sans 10
    status_command ~/.local/bin/statusbar
    status_padding 3
    colors {
        background #000000
        statusline $text
        separator  $surface1
        #                  border     bg         text
        focused_workspace  $surface1  $surface1  $text
        active_workspace   $surface0  $surface0  $text
        inactive_workspace #000000   #000000   $overlay
        urgent_workspace   $red       $red       $crust
    }
}
