# Pegasus frontend always lives on workspace 1 and starts with sway
assign [app_id="org.pegasus-frontend.pegasus-fe"] workspace number 1
exec ~/.config/pegasus-frontend/run
exec ~/.local/bin/inputd

# Everything on workspace 1 (Pegasus and whatever it starts: games, Utilities tools) runs
# fullscreen. Floating windows (dialogs) are left alone.
for_window [workspace="^1$" tiling] fullscreen enable
exec ~/.config/sway/pegasus-fullscreen.sh
