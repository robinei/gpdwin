#!/bin/sh
# After waking from hibernation the rt5645 codec can report headphones plugged in although there
# are none (2026-10-08): UCM then switches the speaker off and only a "Headphones" sink remains.
# Rebinding the codec and the machine driver reruns the jack detection; PipeWire picks the card up
# again. Only after hibernation (SYSTEMD_SLEEP_ACTION=hibernate, also for the hibernate phase of
# suspend-then-hibernate), not after a plain suspend, so running games keep their audio.
[ "$1" = post ] || exit 0
[ "${SYSTEMD_SLEEP_ACTION:-$2}" = hibernate ] || exit 0
m=/sys/bus/platform/drivers/cht-bsw-rt5645
c=/sys/bus/i2c/drivers/rt5645
[ -e "$c/i2c-10EC5645:00" ] || exit 0
echo "audio-jack: rebinding rt5645 codec and machine driver to redo jack detection" >&2
[ -e "$m/cht-bsw-rt5645" ] && echo cht-bsw-rt5645 > "$m/unbind"
sleep 1
echo i2c-10EC5645:00 > "$c/unbind"
sleep 1
echo i2c-10EC5645:00 > "$c/bind"
sleep 1
[ -e "$m/cht-bsw-rt5645" ] || echo cht-bsw-rt5645 > "$m/bind"
exit 0
