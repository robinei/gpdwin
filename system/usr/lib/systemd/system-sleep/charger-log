#!/bin/sh
# Log the charger state before and after sleep (journalctl -t charger-log), to find out why charging
# sometimes stays at 500 mA after a hibernate wake (docs/power.md, "Charging stuck at 500 mA").
# Read-only: PMIC config/status registers (no IRQ status registers, those are acknowledged by
# writing) and the bq24190's sysfs fields. Good-boot baseline: CHGRCTRL0 0x38, CHGDISCTRL 0x10.
P=/sys/class/power_supply
B=$P/bq24190-charger
T=$P/tcpm-source-psy-i2c-fusb302

reg() { # name, i2c address, register
    printf ' %s=%s' "$1" "$(i2cget -f -y 5 "$2" "$3" 2>/dev/null || echo err)"
}

{
    printf '%s %s (%s):' "$1" "$2" "${SYSTEMD_SLEEP_ACTION:-}"
    reg CHGRCTRL0 0x5e 0x16
    reg CHGRCTRL1 0x5e 0x17
    reg CHGDISCTRL 0x5e 0x2f
    reg USBSRC 0x5e 0x29
    reg PHYCTRL 0x5e 0x07
    reg PWRSRC_STS 0x6e 0x1e
    reg PWRSRC_IRQ_MASK 0x6e 0x0f
    reg EXTCHGRIRQ_MSK 0x6e 0x17
    reg IRQLVL1_MASK 0x6e 0x0e
    for f in online status input_current_limit f_vbus_stat f_pg_stat f_dpm_stat f_chrg_stat \
        f_iinlim f_en_hiz f_chg_config f_ichg f_vreg f_watchdog f_watchdog_fault; do
        printf ' %s=%s' "$f" "$(cat $B/$f 2>/dev/null || echo err)"
    done
    printf ' tcpm_online=%s tcpm_current_max=%s' "$(cat $T/online 2>/dev/null)" \
        "$(cat $T/current_max 2>/dev/null)"
    echo
} | logger -t charger-log
exit 0
